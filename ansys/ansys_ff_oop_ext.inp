! ===========================================================================
!  ansys_ff_oop_ext.inp  --  Mechanical APDL batch deck
!  EXTENDED-RANGE out-of-plane free-free isotropic benchmark (FF-P1).
!
!  WHY (from the 2026-07-11 s8 regeneration, job 2316746): the extended
!  window (raw Omega up to 2.80 ~= Omega_lit 110.5) produced, above the old
!  benchmark's 102.136 ceiling region:
!      raw 2.577892 -> lit 101.7711  screens ARTIFACT (rM=77)
!      raw 2.602500 -> lit 102.7426  screens REAL     (rM=0.017)
!      raw 2.746824 -> lit 108.4403  screens ARTIFACT (rM=1.78, borderline)
!  The 102.136 Ansys target was matched to the REAL 102.74 row (0.59% err),
!  but the ARTIFACT 101.77 row is numerically CLOSER to 102.136 (0.36%).
!  The old truth list ended at 102.136 (NMODES=24 on SHELL281, interleaved
!  with IP modes), so there is no FE data to (a) confirm the 102 assignment
!  by exclusion, (b) confirm NO OOP mode exists near 101.77, (c) test the
!  borderline 108.44 artifact call, or (d) inventory 103-116 for solver
!  misses. This deck extends the spectrum: same SHELL281 model as the
!  validated ansys_ff_isoval.inp Pass 2, NMODES raised to 60, two mesh
!  passes for the convergence gate.
!
!  GEOMETRY/MATERIAL (identical to ansys_ff_isoval.inp Pass 2 and the
!  plate_solver runs): R_i=4, R_o=8, PHI=90, H=0.08, E=210e9, nu=0.30,
!  rho=7800. Omega_lit = w*R_o^2*sqrt(rho*H/D), D=E*H^3/(12(1-nu^2)).
!
!  MODE-FAMILY SEPARATION (SHELL281 interleaves OOP and IP): the pure-IP
!  spectrum for this exact geometry/material is already known from the
!  PLANE183 run (job 2316743, ip_modes_mesh80.txt). Any elastic SHELL mode
!  whose f[Hz] matches an ip_modes_mesh80 frequency within ~0.5% is an IP
!  mode -- discard it. The remainder are the OOP modes. Modes 1-6 are
!  rigid (~0 Hz). (IP f[Hz] for reference: 161.4, 276.5, 307.5, 459.5,
!  460.6, 481.7, 569.7, 579.3, 612.3, 643.1, 648.8, 679.8, 715.9, 736.8,
!  793.6, 799.3, 803.0, 871.6, 922.3, 925.7, 960.7, 985.7, 1014.1, 1032.0,
!  1075.9, 1114.9, 1115.3)
!
!  DECISIVE CHECKS (predictions from the s8 OOP table + screen):
!    1. Exactly ONE OOP mode in Omega_lit (100, 110), at ~102.1
!       -> confirms the 102.74-row assignment AND the 101.77 artifact call.
!    2. NO OOP mode near 108.4 -> confirms the borderline (rM=1.78)
!       artifact call at raw 2.746824.
!    3. Inventory all OOP modes with Omega_lit in (102.5, ~118): any FE
!       OOP mode there NOT within ~1% of a REAL solver row is a solver
!       miss above the old ceiling -> feed to a targeted rescan (the
!       reversecheck recipe).
!    4. Convergence gate first: elastic modes must agree mesh64 vs mesh96
!       to <0.3% before any comparison.
!
!  Run headless:  mapdl -b -i ansys_ff_oop_ext.inp -o ansys_ff_oop_ext_out.txt
!  Outputs: oop_ext_mesh64.txt, oop_ext_mesh96.txt
! ===========================================================================

FINISH
/CLEAR,NOSTART
/TITLE, OOP free-free extended benchmark -- Pass 1: mesh 64

R_i    = 4.0
R_o    = 8.0
PHI    = 90.0
H      = 0.08
E_iso  = 210.0e9
NU_iso = 0.30
RHO    = 7800.0
NDIV   = 64
NMODES = 60
PI     = 3.14159265358979

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
ESYS, 11
TYPE,1 $ SECNUM,1 $ MAT,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NDIV
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NDIV
ALLSEL, ALL
CSYS, 0
MSHKEY, 1 $ AMESH, ALL
! completely free (FFFF): no constraints
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
DD   = E_iso*H**3/(12*(1-NU_iso**2))
KLIT = R_o**2*SQRT(RHO*H/DD)

*DIM, FRA, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FRA(I), MODE, I, FREQ
*ENDDO

*CFOPEN, oop_ext_mesh64, txt
*VWRITE
('mode      f[Hz]           Omega_lit    (SHELL281 64x64 FFFF; modes 1-6 rigid; discard IP modes by matching f[Hz] against ip_modes_mesh80.txt within 0.5%; remainder are OOP)')
*DO, I, 1, NMODES
  OML = 2*PI*FRA(I)*KLIT
  *VWRITE, I, FRA(I), OML
(F4.0, 3X, E14.6, 3X, F12.4)
*ENDDO
*CFCLOS

*DO, I, 1, NMODES
  OML = 2*PI*FRA(I)*KLIT
  /COM, MESH64 MODE %I%  f= %FRA(I)% Hz   Omega_lit= %OML%
*ENDDO
FINISH

! ===========================================================================
FINISH
/CLEAR,NOSTART
/TITLE, OOP free-free extended benchmark -- Pass 2: mesh 96 (convergence)

R_i    = 4.0
R_o    = 8.0
PHI    = 90.0
H      = 0.08
E_iso  = 210.0e9
NU_iso = 0.30
RHO    = 7800.0
NDIV   = 96
NMODES = 60
PI     = 3.14159265358979

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
ESYS, 11
TYPE,1 $ SECNUM,1 $ MAT,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NDIV
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NDIV
ALLSEL, ALL
CSYS, 0
MSHKEY, 1 $ AMESH, ALL
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
DD   = E_iso*H**3/(12*(1-NU_iso**2))
KLIT = R_o**2*SQRT(RHO*H/DD)

*DIM, FRB, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FRB(I), MODE, I, FREQ
*ENDDO

*CFOPEN, oop_ext_mesh96, txt
*VWRITE
('mode      f[Hz]           Omega_lit    (SHELL281 96x96 FFFF; convergence pass -- elastic modes must agree with mesh64 to <0.3% before comparison)')
*DO, I, 1, NMODES
  OML = 2*PI*FRB(I)*KLIT
  *VWRITE, I, FRB(I), OML
(F4.0, 3X, E14.6, 3X, F12.4)
*ENDDO
*CFCLOS

*DO, I, 1, NMODES
  OML = 2*PI*FRB(I)*KLIT
  /COM, MESH96 MODE %I%  f= %FRB(I)% Hz   Omega_lit= %OML%
*ENDDO
FINISH
! ---------------------------------------------------------------------------
!  AFTER RUNNING (order matters):
!   1. Convergence gate: mesh64 vs mesh96 elastic modes < 0.3%.
!   2. Family-separate: drop every SHELL mode matching an ip_modes_mesh80
!      frequency within 0.5% in f[Hz]; the remainder (minus 6 rigid) are
!      the OOP list.
!   3. Decisive checks 1-3 from the header against the s8 OOP table:
!        REAL rows:    15.15, 24.34, 37.95, 54.07, 69.17, 91.62, 93.96,
!                      102.74 (lit)
!        ARTIFACT rows near/above ceiling: 101.77, 108.44 (predict ABSENT)
!   4. Any converged OOP FE mode in (102.5, 118) with no REAL row within
!      ~1% -> solver miss above the old ceiling; targeted rescan next.
! ===========================================================================
