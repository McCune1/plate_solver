! ===========================================================================
!  ansys_geomsweep_oop_r250.inp  --  GENERATED by generate_geomsweep_ansys_decks.py, do not
!  hand-edit (edit the generator and rerun instead, or your edit will be lost
!  next regeneration). See that script's module docstring for the full
!  geometry-mapping derivation, material rationale, and single-mesh caveat.
!
!  OOP (SHELL281) free-free FE verification for geometry_sweep's r0_2b=2.5 ratio
!  ('r250'), all 6 sector angles, NDIV=64 single mesh.
!  Run headless:  mapdl -b -i ansys_geomsweep_oop_r250.inp -o ansys_geomsweep_oop_r250_out.txt
! ===========================================================================

FINISH
/CLEAR,NOSTART
/TITLE, Free-free OOP geomsweep verify -- r250 (r0/2b=2.5) a025 (2T/pi=0.25, PHI=45deg)

R_i    = 8.000000
R_o    = 12.000000
PHI    = 45.000000
H      = 0.08
E_iso  = 210000000000.0
NU_iso = 0.35
RHO    = 7800.0
NDIV   = 64
NMODES = 40
PI     = 3.14159265358979

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
ESYS, 11
TYPE,1 $ SECNUM,1 $ MAT,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NDIV
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NDIV
ALLSEL, ALL
CSYS, 0
MSHKEY, 1 $ AMESH, ALL
! completely free (FFFF): no constraints
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
DD   = E_iso*H**3/(12*(1-NU_iso**2))
KLIT = R_o**2*SQRT(RHO*H/DD)

*DIM, FR_r250_a025, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FR_r250_a025(I), MODE, I, FREQ
*ENDDO

! BUGFIX 2026-07-21: *VWRITE is a vector command -- calling it INSIDE a *DO
! loop with array-indexed args does not print one row per iteration, it
! dumps the WHOLE remaining array (from the current start index to NMODES)
! on every call, producing a triangular cascade of repeated/redundant rows
! (previously recovered by taking only the first NMODES-row block; see
! FutureWork memory 2026-07-21). Fixed to match the _ip_pass() block below:
! build the mode-index and Omega_lit arrays once, then *VWRITE the full
! vectors in a SINGLE call outside any loop.
*DIM, MIDX_r250_a025, ARRAY, NMODES
*VFILL, MIDX_r250_a025, RAMP, 1, 1
KLIT2PI = 2*PI*KLIT
*DIM, OML_r250_a025, ARRAY, NMODES
*VOPER, OML_r250_a025(1), FR_r250_a025(1), MULT, KLIT2PI

*CFOPEN, geomsweep_oop_r250_a025, txt
*VWRITE
('mode      f[Hz]           Omega_lit    (SHELL281 NDIV=64, r250 r0/2b=2.5, a025 2T/pi=0.25 PHI=45deg, FFFF; ~6 rigid modes near 0 Hz; IP modes interleaved -- cross-check vs geomsweep_ip_r250_a025.txt)')
*VWRITE, MIDX_r250_a025(1), FR_r250_a025(1), OML_r250_a025(1)
(F4.0, 3X, E14.6, 3X, F12.4)
*CFCLOS
FINISH
FINISH
/CLEAR,NOSTART
