FINISH
/CLEAR,NOSTART
/TITLE, Free-free IP geomsweep verify -- r167 (r0/2b=1.66667) a025 (2T/pi=0.25, PHI=45deg)

R_i    = 4.666680
R_o    = 8.666680
PHI    = 45.000000
H      = 0.08
E_iso  = 210000000000.0
NU_iso = 0.35
RHO    = 7800.0
NDIV   = 64
NMODES = 35

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, PLANE183
KEYOPT, 1, 3, 3
R, 1, H
MP, EX,1,E_iso
MP, PRXY,1,NU_iso
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
TYPE,1 $ MAT,1 $ REAL,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NDIV
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NDIV
ALLSEL, ALL
CSYS, 0
MSHKEY, 1 $ AMESH, ALL
! completely free (FFFF): no constraints
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
*DIM, MIDX_r167_a025, ARRAY, NMODES
*VFILL, MIDX_r167_a025, RAMP, 1, 1
*DIM, FR_r167_a025, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FR_r167_a025(I), MODE, I, FREQ
*ENDDO

*CFOPEN, geomsweep_ip_r167_a025, txt
*VWRITE
('mode      f[Hz]           (PLANE183 NDIV=64, r167 r0/2b=1.66667, a025 2T/pi=0.25 PHI=45deg, FFFF; 3 rigid modes near 0 Hz; no family separation needed)')
*VWRITE, MIDX_r167_a025(1), FR_r167_a025(1)
(F4.0, 3X, E14.6)
*CFCLOS
FINISH
