CSYS, 0
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
DD   = E_iso*H**3/(12*(1-NU_iso**2))
KLIT = R_o**2*SQRT(RHO*H/DD)
*DIM, FRS2, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FRS2(I), MODE, I, FREQ
*ENDDO
*CFOPEN, oop_hs_symm_mesh96, txt
*VWRITE
('mode      f[Hz]           Omega_lit    (half-sector SYMM=EVEN parity; SHELL281 r96/a48; convergence pass, must agree with r64/a32 <0.3%)')
*DO, I, 1, NMODES
  OML = 2*PI*FRS2(I)*KLIT
  *VWRITE, I, FRS2(I), OML
(F4.0, 3X, E14.6, 3X, F12.4)
*ENDDO
*CFCLOS
FINISH

