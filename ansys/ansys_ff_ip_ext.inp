! ===========================================================================
!  ansys_ff_ip_ext.inp  --  Mechanical APDL batch deck
!  ISOTROPIC free-free (FFFF) EXTENSIONAL (in-plane) benchmark, two-mesh.
!
!  This is the PLANE183 plane-stress deck behind PAPER1 §6.3 Table tab:ip.
!  It has been run; the MAPDL log is ansys_ff_ip_ext_out.txt. The two
!  extracted frequency lists are ip_ext_mesh64.txt and ip_ext_mesh96.txt.
!  Realized 64->96 agreement over the 27 elastic modes below 1120 Hz is
!  5.8e-4% (paper §6.3), well inside the <0.3% gate the deck was written
!  to enforce. Do not treat this file as an unrun recreation.
!
!  GEOMETRY/MATERIAL: identical to the isotropic FF-P1 flexural decks
!  (R_i=4, R_o=8, PHI=90 deg, H=0.08, E=210e9, nu=0.30, rho=7800) -- same
!  physical plate, so the IP spectrum is directly comparable to
!  plate_solver's tab:ip column. Comparison is in Hz (no Omega_lit
!  conversion; the in-plane raw Omega already is omega/omega_bar).
!
!  ELEMENT: PLANE183 plane-stress (KEYOPT(3)=3, thickness via a real
!  constant). UX/UY only -- no out-of-plane family to separate. Isotropic
!  material needs no ESYS; CSYS,11 is used only for LOC,X/LOC,Y meshing.
!
!  NMODES=35 (3 rigid in-plane + 27 catalogued elastic IP modes + margin).
!
!  *VWRITE DISCIPLINE: fill the result array inside the *DO loop, then
!  call *VWRITE once per pass AFTER the loop, over the full array from
!  index 1. Never call *VWRITE with an indexed array argument inside a
!  *DO loop (see ansys_ff_ortho_oop.inp).
!
!  Run headless:  mapdl -b -smp -np 8 -i ansys_ff_ip_ext.inp -o ansys_ff_ip_ext_out.txt
!  Outputs: ip_ext_mesh64.txt, ip_ext_mesh96.txt (mode, f[Hz] per mode).
! ===========================================================================

FINISH
/CLEAR,NOSTART
/TITLE, Isotropic free-free extensional (in-plane) benchmark -- Pass 1: mesh 64

R_i    = 4.0
R_o    = 8.0
PHI    = 90.0
H      = 0.08
E_iso  = 210.0e9
NU_iso = 0.30
RHO    = 7800.0
NDIV   = 64
NMODES = 35

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, PLANE183
KEYOPT, 1, 3, 3
R, 1, H
MP, EX,1,E_iso
MP, PRXY,1,NU_iso
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
TYPE,1 $ MAT,1 $ REAL,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NDIV
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NDIV
ALLSEL, ALL
CSYS, 0
MSHKEY, 1 $ AMESH, ALL
! completely free (FFFF): no constraints
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
*DIM, MIDX, ARRAY, NMODES
*VFILL, MIDX, RAMP, 1, 1
*DIM, FRA, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FRA(I), MODE, I, FREQ
*ENDDO

*CFOPEN, ip_ext_mesh64, txt
*VWRITE
('mode      f[Hz]           (PLANE183 64x64 isotropic FFFF, plane stress; modes 1-3 rigid; remainder are the in-plane/extensional spectrum, no family separation needed)')
*VWRITE, MIDX(1), FRA(1)
(F4.0, 3X, E14.6)
*CFCLOS
FINISH

! ===========================================================================
FINISH
/CLEAR,NOSTART
/TITLE, Isotropic free-free extensional (in-plane) benchmark -- Pass 2: mesh 96 (convergence)

R_i    = 4.0
R_o    = 8.0
PHI    = 90.0
H      = 0.08
E_iso  = 210.0e9
NU_iso = 0.30
RHO    = 7800.0
NDIV   = 96
NMODES = 35

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, PLANE183
KEYOPT, 1, 3, 3
R, 1, H
MP, EX,1,E_iso
MP, PRXY,1,NU_iso
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
TYPE,1 $ MAT,1 $ REAL,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NDIV
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NDIV
ALLSEL, ALL
CSYS, 0
MSHKEY, 1 $ AMESH, ALL
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
*DIM, MIDXB, ARRAY, NMODES
*VFILL, MIDXB, RAMP, 1, 1
*DIM, FRB, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FRB(I), MODE, I, FREQ
*ENDDO

*CFOPEN, ip_ext_mesh96, txt
*VWRITE
('mode      f[Hz]           (PLANE183 96x96 isotropic FFFF, plane stress; convergence pass -- must agree with mesh64 to <0.3% before use)')
*VWRITE, MIDXB(1), FRB(1)
(F4.0, 3X, E14.6)
*CFCLOS
FINISH
! ---------------------------------------------------------------------------
!  AFTER RUNNING (order matters):
!   1. Skip modes 1-3 (rigid, ~0 Hz) in both files.
!   2. Convergence gate: mesh64 vs mesh96 must agree to <0.3% per mode --
!      this project's standard gate, and exactly what Sec 6.3 claims for
!      this model.
!   3. Compare the converged (mesh96) 27-ish-mode list against the
!      historical ip_modes_mesh80.txt values quoted in this deck's header
!      and in LESSONS_LEARNED.md Sec 20.2 -- confirms (or corrects) that
!      record independently of whatever happened to the original deck.
! ===========================================================================
