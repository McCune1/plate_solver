! ======================= PASS ASYM, mesh2 =======================
FINISH
/CLEAR,NOSTART
/TITLE, rect half-model FFFF -- ASYM (odd) cut BC, mesh2 (convergence)

B      = 1.0
LOB    = 1.5
L      = LOB*B
H      = 0.04
E_iso  = 210.0e9
NU_iso = 0.30
RHO    = 7800.0
NDIVX  = 90
