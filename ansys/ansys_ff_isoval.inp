! ===========================================================================
!  ansys_ff_isoval.inp  --  Mechanical APDL batch deck
!  TWO-PASS free-free ISOTROPIC validation for the plate_solver free-free
!  extension (LESSONS_LEARNED.md §23.7 item 2 / §23.6).
!
!  Pass 1 (CALIBRATION): ISO=1, PHI=120, BC=0 (free) -- pins the Omega
!    convention. Known target: first elastic Omega ~= 10.19 (Shi isotropic
!    JVC paper, FFFF annular sector, a/b=0.5, phi=120deg). If this does NOT
!    match with BREF=0 (b=R_o), switch BREF=1 (b=width) and re-check before
!    trusting Pass 2 at all -- see ansys_sector_modal.inp's header notes.
!
!  Pass 2 (TARGET): ISO=1, PHI=90, BC=0 (free) -- the actual comparison case.
!    Geometry (R_i=4, R_o=8 -> R_i/R_o=0.5) and material (E=210 GPa, nu=0.30)
!    are matched EXACTLY to plate_solver's submit_ff_isoval.sh
!    (R40_FF_P1=1.5:0.5, MAT_NU=0.30), which already produced (job 2312095):
!        Omega_lit (OOP, 8 modes) = [12.6596, 15.1389, 24.3442, 33.3391,
!                                     37.9182, 39.5575, 54.0755, 63.2524]
!    Both sides use Omega = w*R_o^2*sqrt(rho*H/D) (McGee/Leissa & Shi/Lv
!    convention) -- directly comparable, target agreement ~1-2% like the
!    Shi orthotropic benchmark (LESSONS §21.3).
!
!  Run headless (single command, no GUI):
!     mapdl -b -i ansys_ff_isoval.inp -o ansys_ff_isoval_out.txt
!
!  Outputs: sector_modes_calib.txt, sector_modes_target.txt
!  (modes 1-6 are rigid-body ~0 in both passes since BC=0/free; elastic
!  modes start at mode 7 -- tag OOP/bending modes via PLNSOL,U,Z and compare
!  those Omega values against the plate_solver list above, in order.)
! ===========================================================================

FINISH
/CLEAR,NOSTART
/TITLE, Free-free isotropic validation -- Pass 1: CALIBRATION (PHI=120)

! ---------------------------- PARAMETERS -----------------------------------
ISO    = 1            ! isotropic calibration material
BC     = 0            ! completely FREE (FFFF)
BREF   = 0            ! Omega reference length: 0 = R_o (outer)
R_i    = 4.0
R_o    = 8.0
PHI    = 120.0         ! CALIBRATION angle (Shi isotropic JVC benchmark)
H      = 0.08

RHO    = 7850.0
E_r    = 40.0e9
E_th   = 70.0e9
MU_R   = 0.30
G_rt   = 3.51e9

E_iso  = 210.0e9
NU_iso = 0.30

NRAD   = 48
NCIRC  = 48
NMODES = 24
PI     = 3.14159265358979

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
ESYS, 11
TYPE,1 $ SECNUM,1 $ MAT,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NRAD
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NCIRC
ALLSEL, ALL
MSHKEY, 1 $ AMESH, ALL
! BC=0 -> no constraints (free-free)
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
D11 = E_iso*H**3/(12*(1-NU_iso**2))
*IF, BREF, EQ, 1, THEN
  BL = R_o - R_i
*ELSE
  BL = R_o
*ENDIF
KFAC = BL**2*sqrt(RHO*H/D11)

*DIM, FR1, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FR1(I), MODE, I, FREQ
*ENDDO

*CFOPEN, sector_modes_calib, txt
*VWRITE
('mode      f[Hz]              Omega   (CALIBRATION: BC=0,ISO=1,BREF=0,PHI=120; expect first elastic Omega ~10.19)')
*DO, I, 1, NMODES
  OM = 2*PI*FR1(I)*KFAC
  *VWRITE, I, FR1(I), OM
(F4.0, 3X, E16.8, 3X, F14.6)
*ENDDO
*CFCLOS

*DO, I, 1, NMODES
  OM = 2*PI*FR1(I)*KFAC
  /COM, CALIB MODE %I%  f= %FR1(I)% Hz   Omega= %OM%
*ENDDO
FINISH

! ===========================================================================
FINISH
/CLEAR,NOSTART
/TITLE, Free-free isotropic validation -- Pass 2: TARGET (PHI=90)

ISO    = 1
BC     = 0
BREF   = 0
R_i    = 4.0
R_o    = 8.0
PHI    = 90.0          ! TARGET angle -- matches R40_FF_P1=1.5:0.5
H      = 0.08

RHO    = 7800.0        ! matches MAT_RHO in submit_ff_isoval.sh (NOT 7850 -- that's the Shi material, this pass is the isotropic match)
E_iso  = 210.0e9        ! matches MAT_E
NU_iso = 0.30           ! matches MAT_NU

NRAD   = 48
NCIRC  = 48
NMODES = 24
PI     = 3.14159265358979

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
ESYS, 11
TYPE,1 $ SECNUM,1 $ MAT,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NRAD
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NCIRC
ALLSEL, ALL
MSHKEY, 1 $ AMESH, ALL
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
D11 = E_iso*H**3/(12*(1-NU_iso**2))
*IF, BREF, EQ, 1, THEN
  BL = R_o - R_i
*ELSE
  BL = R_o
*ENDIF
KFAC = BL**2*sqrt(RHO*H/D11)

*DIM, FR2, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FR2(I), MODE, I, FREQ
*ENDDO

*CFOPEN, sector_modes_target, txt
*VWRITE
('mode      f[Hz]              Omega   (TARGET: BC=0,ISO=1,BREF=0,PHI=90; compare elastic modes to plate_solver Omega_lit=[12.6596,15.1389,24.3442,33.3391,37.9182,39.5575,54.0755,63.2524])')
*DO, I, 1, NMODES
  OM = 2*PI*FR2(I)*KFAC
  *VWRITE, I, FR2(I), OM
(F4.0, 3X, E16.8, 3X, F14.6)
*ENDDO
*CFCLOS

*DO, I, 1, NMODES
  OM = 2*PI*FR2(I)*KFAC
  /COM, TARGET MODE %I%  f= %FR2(I)% Hz   Omega= %OM%
*ENDDO
FINISH
! ---------------------------------------------------------------------------
!  AFTER RUNNING:
!   1. Check sector_modes_calib.txt first: modes 1-6 ~0 (rigid body), mode 7
!      (first elastic) should read Omega ~10.19. If not within ~1-2%, the
!      BREF convention is wrong -- flip BREF=1 in BOTH passes and re-run
!      before trusting sector_modes_target.txt at all.
!   2. sector_modes_target.txt: modes 1-6 ~0 (rigid body), modes 7-14 are the
!      8 elastic OOP modes to compare (in order) against plate_solver's
!      [12.6596, 15.1389, 24.3442, 33.3391, 37.9182, 39.5575, 54.0755, 63.2524].
!      Tag OOP (bending, Uz-dominant) modes via PLNSOL,U,Z if in-plane modes
!      are interleaved -- SHELL281 free-free will have both families mixed
!      in mode order.
!   3. Mesh convergence: rerun NRAD=NCIRC=64,80 (Omega stable to <0.5% expected).
! ===========================================================================
