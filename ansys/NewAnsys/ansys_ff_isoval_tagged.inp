! ===========================================================================
!  ansys_ff_isoval_tagged.inp  --  Mechanical APDL batch deck
!  Same TWO-PASS free-free ISOTROPIC validation as ansys_ff_isoval.inp
!  (LESSONS_LEARNED.md §23.7 item 2 / §23.6), SAME mesh (NRAD=NCIRC=48) as
!  the run already reported (job 2313xxx TARGET pass), PLUS Uz-dominance
!  mode tagging on Pass 2 -- this is item 1 of the two open follow-ups from
!  that comparison (the deck's own trailing note flagged it but it was
!  never executed): confirm whether FE modes 7-14 really are the pure
!  bending sequence the positional comparison assumes, or whether
!  membrane/coupled modes are interleaved (SHELL281 free-free mixes both
!  families in mode order).
!
!  Pass 1 (CALIBRATION): unchanged from ansys_ff_isoval.inp -- pins the
!    Omega convention, target first elastic Omega ~10.19.
!  Pass 2 (TARGET): same PHI=90, R_i/R_o=0.5, E=210GPa, nu=0.30 as before,
!    but /POST1 now also computes UzFrac = SUM(Uz^2)/SUM(Ux^2+Uy^2+Uz^2)
!    per mode (see _tag_macro block below) and writes it alongside the
!    usual f/Omega columns.
!
!  NOTE (honesty flag): the *GET/*VGET/*VOPER/*VSCFUN sequence below was
!  written from documented APDL syntax but NOT executed against a real
!  Mechanical APDL install (none available in the environment this was
!  authored in) -- sanity-check the first few lines of the .err log after
!  submitting; if *GET,NMX,NODE,0,NUM,MAX or the *VGET Item2=U,X/Y/Z forms
!  throw a syntax error on your Ansys version, that's the first place to
!  look.
!
!  Run headless (single command, no GUI):
!     mapdl -b -i ansys_ff_isoval_tagged.inp -o ansys_ff_isoval_tagged_out.txt
!
!  Outputs: sector_modes_calib.txt, sector_modes_target.txt (unchanged, same
!  as before), PLUS sector_modes_target_tags.txt (new).
! ===========================================================================

FINISH
/CLEAR,NOSTART
/TITLE, Free-free isotropic validation -- Pass 1: CALIBRATION (PHI=120)

! ---------------------------- PARAMETERS -----------------------------------
ISO    = 1            ! isotropic calibration material
BC     = 0            ! completely FREE (FFFF)
BREF   = 0            ! Omega reference length: 0 = R_o (outer)
R_i    = 4.0
R_o    = 8.0
PHI    = 120.0         ! CALIBRATION angle (Shi isotropic JVC benchmark)
H      = 0.08

RHO    = 7850.0
E_r    = 40.0e9
E_th   = 70.0e9
MU_R   = 0.30
G_rt   = 3.51e9

E_iso  = 210.0e9
NU_iso = 0.30

NRAD   = 48
NCIRC  = 48
NMODES = 24
PI     = 3.14159265358979

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
ESYS, 11
TYPE,1 $ SECNUM,1 $ MAT,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NRAD
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NCIRC
ALLSEL, ALL
MSHKEY, 1 $ AMESH, ALL
! BC=0 -> no constraints (free-free)
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
D11 = E_iso*H**3/(12*(1-NU_iso**2))
*IF, BREF, EQ, 1, THEN
  BL = R_o - R_i
*ELSE
  BL = R_o
*ENDIF
KFAC = BL**2*sqrt(RHO*H/D11)

*DIM, FR1, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FR1(I), MODE, I, FREQ
*ENDDO

*CFOPEN, sector_modes_calib, txt
*VWRITE
('mode      f[Hz]              Omega   (CALIBRATION: BC=0,ISO=1,BREF=0,PHI=120; expect first elastic Omega ~10.19)')
*DO, I, 1, NMODES
  OM = 2*PI*FR1(I)*KFAC
  *VWRITE, I, FR1(I), OM
(F4.0, 3X, E16.8, 3X, F14.6)
*ENDDO
*CFCLOS

*DO, I, 1, NMODES
  OM = 2*PI*FR1(I)*KFAC
  /COM, CALIB MODE %I%  f= %FR1(I)% Hz   Omega= %OM%
*ENDDO
FINISH

! ===========================================================================
FINISH
/CLEAR,NOSTART
/TITLE, Free-free isotropic validation -- Pass 2: TARGET (PHI=90), TAGGED

ISO    = 1
BC     = 0
BREF   = 0
R_i    = 4.0
R_o    = 8.0
PHI    = 90.0          ! TARGET angle -- matches R40_FF_P1=1.5:0.5
H      = 0.08

RHO    = 7800.0        ! matches MAT_RHO in submit_ff_isoval.sh (NOT 7850 -- that's the Shi material, this pass is the isotropic match)
E_iso  = 210.0e9        ! matches MAT_E
NU_iso = 0.30           ! matches MAT_NU

NRAD   = 48
NCIRC  = 48
NMODES = 24
PI     = 3.14159265358979

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
ESYS, 11
TYPE,1 $ SECNUM,1 $ MAT,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NRAD
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NCIRC
ALLSEL, ALL
MSHKEY, 1 $ AMESH, ALL
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
D11 = E_iso*H**3/(12*(1-NU_iso**2))
*IF, BREF, EQ, 1, THEN
  BL = R_o - R_i
*ELSE
  BL = R_o
*ENDIF
KFAC = BL**2*sqrt(RHO*H/D11)

*DIM, FR2, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FR2(I), MODE, I, FREQ
*ENDDO

*CFOPEN, sector_modes_target, txt
*VWRITE
('mode      f[Hz]              Omega   (TARGET: BC=0,ISO=1,BREF=0,PHI=90; compare elastic modes to plate_solver Omega_lit=[12.6596,15.1389,24.3442,33.3391,37.9182,39.5575,54.0755,63.2524])')
*DO, I, 1, NMODES
  OM = 2*PI*FR2(I)*KFAC
  *VWRITE, I, FR2(I), OM
(F4.0, 3X, E16.8, 3X, F14.6)
*ENDDO
*CFCLOS

! ---- Uz-dominance tagging (answers LESSONS §23.7 item 2's open question:
!      are modes 7-14 really the pure-bending sequence, or are membrane/
!      coupled modes interleaved?) ---------------------------------------
! For each expanded mode shape, sums UX^2, UY^2, UZ^2 over all nodes and
! reports UzFrac = SUM(UZ^2) / SUM(UX^2+UY^2+UZ^2). UzFrac near 1.0 =>
! motion is essentially pure out-of-plane bending (Uz-dominant). UzFrac
! well below ~0.9 => meaningful in-plane/membrane content is mixed into
! that mode -- exclude it from a straight bending-mode comparison and
! look at the next candidate instead.
*GET, NMX, NODE, 0, NUM, MAX
*DIM, UXA, ARRAY, NMX
*DIM, UYA, ARRAY, NMX
*DIM, UZA, ARRAY, NMX
*DIM, UX2, ARRAY, NMX
*DIM, UY2, ARRAY, NMX
*DIM, UZ2, ARRAY, NMX
*DIM, TAG, ARRAY, NMODES

*DO, I, 1, NMODES
  SET, 1, I
  *VGET, UXA(1), NODE, 1, U, X
  *VGET, UYA(1), NODE, 1, U, Y
  *VGET, UZA(1), NODE, 1, U, Z
  *VOPER, UX2(1), UXA(1), MULT, UXA(1)
  *VOPER, UY2(1), UYA(1), MULT, UYA(1)
  *VOPER, UZ2(1), UZA(1), MULT, UZA(1)
  *VSCFUN, SUX2, SUM, UX2(1)
  *VSCFUN, SUY2, SUM, UY2(1)
  *VSCFUN, SUZ2, SUM, UZ2(1)
  TAG(I) = SUZ2 / (SUX2 + SUY2 + SUZ2 + 1.0E-30)
*ENDDO

*CFOPEN, sector_modes_target_tags, txt
*VWRITE
('mode      f[Hz]              Omega          UzFrac   (>0.9=bending-dominant, <0.5=in-plane/coupled -- exclude those from the bending comparison)')
*DO, I, 1, NMODES
  OM = 2*PI*FR2(I)*KFAC
  *VWRITE, I, FR2(I), OM, TAG(I)
(F4.0, 3X, E16.8, 3X, F14.6, 3X, F8.4)
*ENDDO
*CFCLOS

FINISH
! ---------------------------------------------------------------------------
!  AFTER RUNNING:
!   1. Check sector_modes_calib.txt: mode 7 should read Omega ~10.19 (same
!      as before -- this pass is unchanged from ansys_ff_isoval.inp).
!   2. Check sector_modes_target_tags.txt: for each of modes 7-14, read
!      UzFrac. Any mode with UzFrac well below ~0.9 is NOT a clean bending
!      mode -- exclude it and shift the remaining bending-mode comparison
!      down the list (i.e. re-do the plate_solver comparison using only
!      the Uz-dominant modes, in order, not raw positional index 7-14).
!   3. Cross-check against the already-collected TARGET numbers: 4 of the
!      8 already matched plate_solver within ~1% (15.13, 24.19, 37.82,
!      53.83 vs 15.14, 24.34, 37.92, 54.08) -- if those four all come back
!      UzFrac>0.9 and the other rows in the 7-14 range come back
!      UzFrac<0.5, that confirms interleaving as the explanation and this
!      investigation is DONE without touching the solver.
! ===========================================================================
