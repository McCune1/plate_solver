LESIZE, ALL, , , NDIVX
LSEL, S, LOC, X, -L $ LSEL, A, LOC, X, L
LESIZE, ALL, , , NDIVY
ALLSEL, ALL
MSHKEY, 1 $ AMESH, ALL
! mirror cut at Y=0: ASYM (odd) pattern in GLOBAL Cartesian
NSEL, S, LOC, Y, 0
D, ALL, UX, 0 $ D, ALL, UZ, 0 $ D, ALL, ROTY, 0
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
GG2   = E_iso/(2*(1+NU_iso))
KFAC  = (PI*(H/2))/(4*B*B) * SQRT(GG2/(6*RHO*(1-NU_iso)))
*DIM, FRA1, ARRAY, NMODES
*DIM, MIDX, ARRAY, NMODES
*DIM, LFEA, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FRA1(I), MODE, I, FREQ
  MIDX(I) = I
  LFEA(I) = FRA1(I)/KFAC
*ENDDO
! FIXED 2026-09-06: single whole-array *VWRITE call -- NEVER *VWRITE
! inside a *DO loop. The old per-iteration-scalar *VWRITE call this
! replaced silently garbled its own output (confirmed: this exact
! block's Lambda_FE column was all-zero on disk with non-monotonic
! mode numbering before this fix). See project memory
! ansys-kfac-runtime-bug.md and paper2-literature-review-gap-2026-09-05.md.
*CFOPEN, rect_ff_asym_mesh1_lob300, txt
*VWRITE
('mode      f[Hz]           Lambda_FE    (ASYM=ODD parity; SHELL281 x60/y20; discard ~0Hz rigid + >30Hz likely-membrane)')
*VWRITE, MIDX(1), FRA1(1), LFEA(1)
(F4.0, 3X, E14.6, 3X, F12.6)
*CFCLOS
FINISH

! ======================= PASS ASYM, mesh2 =======================
FINISH
/CLEAR,NOSTART
/TITLE, rect half-model FFFF l/b=3.0 -- ASYM cut BC, mesh2 (convergence)

B      = 1.0
LOB    = 3.0
L      = LOB*B
H      = 0.04
E_iso  = 210.0e9
NU_iso = 0.30
RHO    = 7800.0
NDIVX  = 180
NDIVY  = 30
NMODES = 30
PI     = 3.14159265358979

/PREP7
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
RECTNG, -L, L, 0, B
TYPE,1 $ SECNUM,1 $ MAT,1
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, B
