! ===========================================================================
!  ansys_rect_ff_oop_halfmodel_lob300.inp  --  Mechanical APDL batch deck
!  Rectangular free-free (FFFF) OOP FE ground truth, l/b=3.0 half-model.
!
!  GENERATED 2026-09-04 by copying ansys_rect_ff_oop_halfmodel_lob100.inp
!  (that file itself copied 2026-09-02 from the validated l/b=1.5 deck
!  ansys_rect_ff_oop_halfmodel.inp, job 2398617) and changing ONLY: LOB,
!  NDIVX, *CFOPEN basenames, and /TITLE. Mesh scaling keeps the SAME
!  element size as the l/b=1.5 deck -- elem size 1/20 of B for mesh1,
!  1/30 of B for mesh2, i.e. NDIVX = round(2*LOB*20) = 120 (mesh1)
!  and round(2*LOB*30) = 180 (mesh2). Tagged _lob300 so outputs do
!  not collide with lob100 / lob250 / l/b=1.5 when run from NewAnsys/.
!  The *VWRITE/*DO structure, SYMM/ASYM mirror BCs, material constants,
!  and KFAC formula are copied, not retyped.
!
!  PURPOSE: job 2453876 produced Screen-B PAPER_CANDIDATES at this l/b
!  (listed in the footer) but has no FE at l/b=2.0 or 3.0. This deck is
!  formula-agnostic FE ground truth. Convert Hz with KFAC=24.6644 from
!  the first mode-1 *VWRITE block; do NOT use the deck Lambda_FE column
!  (runtime SQRT missing). Pair SYMM vs SYM and ASYM vs ANTI only.
!  No SOLVER_VERSION action from this deck alone.
!
!  GEOMETRY/MATERIAL (same convention as every other deck in this family):
!    half-breadth B=1.0 m, aspect ratio l/b=3.0 (full length 6.0 m,
!    full breadth 2.0 m), full thickness H=0.04 m (H/(2B)=0.02, thin-plate
!    valid), E=210 GPa, nu=0.30, rho=7800 kg/m^3.
!
!  Lambda -> Hz CONVERSION: identical KFAC derivation to the l/b=1.5 deck
!  (Seok/Tiersten/Scarton 2004 rect Part 1 Eqs.24-28,37-38,41-42) --
!  KFAC = (pi*(H/2))/(4*B^2) * sqrt(G/(6*rho*(1-nu))), independent of LOB.
!  At runtime the APDL SQRT is missing, so ignore Lambda_FE and use
!  Lambda = f[Hz] / 24.6644 from the first mode-1 Hz block.
!
!  WHY A HALF-MODEL / mirror BC pattern: unchanged from the l/b=1.5 deck --
!  SYMM (UY=0,ROTX=0,ROTZ=0) matches solver phin=pi/2 (SYM, even);
!  ASYM (UX=0,UZ=0,ROTY=0) matches solver phin=0 (ANTI, odd).
!
!  READING THIS DECK'S OUTPUT:
!    0. CONVERGENCE GATE FIRST: mesh1 vs mesh2 Hz lists (same parity)
!       must agree <0.3% before reading anything else.
!    1. Discard near-zero (rigid body) entries and anything with
!       f>30 Hz (membrane-mode window).
!    2. Convert surviving Hz with KFAC=24.6644. Compare SYMM-pass against
!       SYM candidates and ASYM-pass against ANTI candidates ONLY.
!    EXPLORATORY. No SOLVER_VERSION action, no table promotion from this
!    deck alone regardless of outcome.
!
!  MUST run from Ansys/NewAnsys/ (one ANSYS license seat, isolated queue
!  submit_ansys_queue_rect_ff_extra_lob.sh). Do NOT submit concurrently
!  with any other MAPDL job.
!    mapdl -b -smp -np 8 -i ansys_rect_ff_oop_halfmodel_lob300.inp -o ansys_rect_ff_oop_halfmodel_lob300_out.txt
!  Outputs: rect_ff_symm_mesh1_lob300.txt, rect_ff_symm_mesh2_lob300.txt,
!           rect_ff_asym_mesh1_lob300.txt, rect_ff_asym_mesh2_lob300.txt
! ===========================================================================

! ======================= PASS SYMM, mesh1 =======================
FINISH
/CLEAR,NOSTART
/TITLE, rect half-model FFFF l/b=3.0 -- SYMM cut BC, mesh1

B      = 1.0
LOB    = 3.0
L      = LOB*B
H      = 0.04
E_iso  = 210.0e9
NU_iso = 0.30
RHO    = 7800.0
NDIVX  = 120
NDIVY  = 20
NMODES = 30
PI     = 3.14159265358979

/PREP7
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
RECTNG, -L, L, 0, B
TYPE,1 $ SECNUM,1 $ MAT,1
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, B
LESIZE, ALL, , , NDIVX
LSEL, S, LOC, X, -L $ LSEL, A, LOC, X, L
LESIZE, ALL, , , NDIVY
ALLSEL, ALL
MSHKEY, 1 $ AMESH, ALL
! mirror cut at Y=0: SYMM (even) pattern in GLOBAL Cartesian (Y already the
! mirror-normal axis, Z the shell normal -- no local CS needed)
NSEL, S, LOC, Y, 0
D, ALL, UY, 0 $ D, ALL, ROTX, 0 $ D, ALL, ROTZ, 0
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
GG2   = E_iso/(2*(1+NU_iso))
KFAC  = (PI*(H/2))/(4*B*B) * SQRT(GG2/(6*RHO*(1-NU_iso)))
*DIM, FRS1, ARRAY, NMODES
*DIM, MIDX, ARRAY, NMODES
*DIM, LFEA, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FRS1(I), MODE, I, FREQ
  MIDX(I) = I
  LFEA(I) = FRS1(I)/KFAC
*ENDDO
! FIXED 2026-09-06: single whole-array *VWRITE call -- NEVER *VWRITE
! inside a *DO loop. The old per-iteration-scalar *VWRITE call this
! replaced silently garbled its own output (confirmed: this exact
! block's Lambda_FE column was all-zero on disk with non-monotonic
! mode numbering before this fix). See project memory
! ansys-kfac-runtime-bug.md and paper2-literature-review-gap-2026-09-05.md.
*CFOPEN, rect_ff_symm_mesh1_lob300, txt
*VWRITE
('mode      f[Hz]           Lambda_FE    (SYMM=EVEN parity; SHELL281 x60/y20; discard ~0Hz rigid + >30Hz likely-membrane)')
*VWRITE, MIDX(1), FRS1(1), LFEA(1)
(F4.0, 3X, E14.6, 3X, F12.6)
*CFCLOS
FINISH

! ======================= PASS SYMM, mesh2 =======================
FINISH
/CLEAR,NOSTART
/TITLE, rect half-model FFFF l/b=3.0 -- SYMM cut BC, mesh2 (convergence)

B      = 1.0
LOB    = 3.0
L      = LOB*B
H      = 0.04
E_iso  = 210.0e9
NU_iso = 0.30
RHO    = 7800.0
NDIVX  = 180
NDIVY  = 30
NMODES = 30
PI     = 3.14159265358979

/PREP7
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
RECTNG, -L, L, 0, B
TYPE,1 $ SECNUM,1 $ MAT,1
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, B
LESIZE, ALL, , , NDIVX
LSEL, S, LOC, X, -L $ LSEL, A, LOC, X, L
LESIZE, ALL, , , NDIVY
ALLSEL, ALL
MSHKEY, 1 $ AMESH, ALL
NSEL, S, LOC, Y, 0
D, ALL, UY, 0 $ D, ALL, ROTX, 0 $ D, ALL, ROTZ, 0
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
GG2   = E_iso/(2*(1+NU_iso))
KFAC  = (PI*(H/2))/(4*B*B) * SQRT(GG2/(6*RHO*(1-NU_iso)))
*DIM, FRS2, ARRAY, NMODES
*DIM, MIDX, ARRAY, NMODES
*DIM, LFEA, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FRS2(I), MODE, I, FREQ
  MIDX(I) = I
  LFEA(I) = FRS2(I)/KFAC
*ENDDO
! FIXED 2026-09-06: single whole-array *VWRITE call -- NEVER *VWRITE
! inside a *DO loop. The old per-iteration-scalar *VWRITE call this
! replaced silently garbled its own output (confirmed: this exact
! block's Lambda_FE column was all-zero on disk with non-monotonic
! mode numbering before this fix). See project memory
! ansys-kfac-runtime-bug.md and paper2-literature-review-gap-2026-09-05.md.
*CFOPEN, rect_ff_symm_mesh2_lob300, txt
*VWRITE
('mode      f[Hz]           Lambda_FE    (SYMM=EVEN parity; SHELL281 x90/y30; must agree with x60/y20 <0.3%)')
*VWRITE, MIDX(1), FRS2(1), LFEA(1)
(F4.0, 3X, E14.6, 3X, F12.6)
*CFCLOS
FINISH

! ======================= PASS ASYM, mesh1 =======================
FINISH
/CLEAR,NOSTART
/TITLE, rect half-model FFFF l/b=3.0 -- ASYM cut BC, mesh1

B      = 1.0
LOB    = 3.0
L      = LOB*B
H      = 0.04
E_iso  = 210.0e9
NU_iso = 0.30
RHO    = 7800.0
NDIVX  = 120
NDIVY  = 20
NMODES = 30
PI     = 3.14159265358979

/PREP7
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
RECTNG, -L, L, 0, B
TYPE,1 $ SECNUM,1 $ MAT,1
