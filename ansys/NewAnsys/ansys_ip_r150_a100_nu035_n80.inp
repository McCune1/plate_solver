! ===========================================================================
!  ansys_ip_r150_a100_nu035_n80.inp
!
!  IP (PLANE183) free-free FE verification for r0_2b=1.5, 2Theta/pi=1
!  (PHI=180deg), nu=0.35 -- SAME geometry/material as the a100 pass of
!  ansys_geomsweep_ip_r150.inp, NMODES raised 35 -> 80.
!
!  WHY: the published 35-mode list ends at 796.661 Hz (FE#35). Job 2347329
!  left 15 of 61 IP solver candidates unmatched because they sit above that
!  ceiling (Om 2.116-2.462, all nearest-neighbor to FE#35 at 4.9-22.0%).
!  NMODES=80 matches the already-run r200/a100 nu=0.30 IP list.
!
!  Single-angle only -- do not regenerate the other five geomsweep angles.
!  Does NOT overwrite geomsweep_ip_r150_a100.txt (the published 35-mode
!  file). Writes geomsweep_ip_r150_a100_nu035_n80.txt instead.
!
!  Run headless:
!    mapdl -b -i ansys_ip_r150_a100_nu035_n80.inp -o ansys_ip_r150_a100_nu035_n80_out.txt
! ===========================================================================

FINISH
/CLEAR,NOSTART
/TITLE, Free-free IP verify (nu=0.35, NMODES=80) -- r150 (r0/2b=1.5) a100 (2T/pi=1, PHI=180deg)

R_i    = 4.000000
R_o    = 8.000000
PHI    = 180.000000
H      = 0.08
E_iso  = 210000000000.0
NU_iso = 0.35
RHO    = 7800.0
NDIV   = 64
NMODES = 80

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, PLANE183
KEYOPT, 1, 3, 3
R, 1, H
MP, EX,1,E_iso
MP, PRXY,1,NU_iso
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
TYPE,1 $ MAT,1 $ REAL,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NDIV
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NDIV
ALLSEL, ALL
CSYS, 0
MSHKEY, 1 $ AMESH, ALL
! completely free (FFFF): no constraints
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
*DIM, MIDX_r150_a100, ARRAY, NMODES
*VFILL, MIDX_r150_a100, RAMP, 1, 1
*DIM, FR_r150_a100, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FR_r150_a100(I), MODE, I, FREQ
*ENDDO

*CFOPEN, geomsweep_ip_r150_a100_nu035_n80, txt
*VWRITE
('mode      f[Hz]           (PLANE183 NDIV=64, r150 r0/2b=1.5, a100 2T/pi=1 PHI=180deg, nu=0.35, NMODES=80, FFFF; 3 rigid modes near 0 Hz; no family separation needed)')
*VWRITE, MIDX_r150_a100(1), FR_r150_a100(1)
(F4.0, 3X, E14.6)
*CFCLOS
FINISH
