! ansys_p4_liudisk2_sc_C_2026-09-24.inp
! Paper 4 lever 11 -- Liu 2002 solid-disk SC FE (Gate 2 CPT targets).
! Built by build_liu_disk_sc_decks_v2_2026-09-24.py. Do not hand-edit; rebuild.
! MESH FIX after job 2530974: true RI=0 is a 3-sided wedge; ANSYS mapped
! hex needs equal even divisions on all three triangle edges. Equalising
! would break polar sample lattice. Restored parent annular LESIZE with
! RI_MESH=3.0 mm (Liu RI=0; hole = 0.50% of RO). Inner arcs=NDIV_TH,
! radials=NDIV_R, 28 lines. v2: hole r=RI_MESH is FREE (v1 UX=0 there
! stiffened every n=1 mode: it blocks the centre tilt u_x=-z dw/dx).
! S deck: UX=0 at ONE outer midplane node (theta=90) kills rigid x-shift.
! SOLID226 KEYOPT(1)=1001, theta=0..180, UY=0 on y=0 (cos(n theta)).
! Both-faces SC. Outer BC: outer clamped: UX=UY=UZ=0 on r=RO cylindrical surface.
! Mesh moderate: 24 radial x 72 circ x (2 host + 1 + 1 skins) = 6912 elements.
! Approx DOF O(2e5). Units mm-N-s-tonne, real volts, RELATIVE permittivity.
! Liu Table 1: C55E=26 GPa (TB C44E), e31=+4.1 project sign, h1=2 mm.
! Prints raw Hz and raw UX/UY/UZ/VOLT at 65 sample nodes only.
! Score externally from raw Hz; never trust deck percentage columns.
! ============================================================
FINISH
/CLEAR,NOSTART
/TITLE, Paper 4 Liu solid-disk SC outer-C SOLID226 (2026-09-24)

RI     = 3.0            ! RI_MESH (Liu physical RI=0); tiny hole for mapped hex
RO     = 600.0            ! Liu r0 = 0.6 m
H      = 10.0            ! host HALF-thickness [mm]
H1     = 2.0             ! each piezo skin [mm] (Liu h1=2 mm)
TH1    = 0.0
TH2    = 180.0
NDIV_R = 24
NDIV_TH = 72
NDIV_ZH = 2
NDIV_ZP = 1
NMODES = 30

! ---- steel host (same TB,ANEL numbers as PLANE223 epsrel / 3-D nge1) ----
E_STEEL   = 2.00E5
NU_STEEL  = 0.3
RHO_STEEL = 7.800E-9
DS11 = E_STEEL*(1-NU_STEEL)/((1+NU_STEEL)*(1-2*NU_STEEL))
DS12 = E_STEEL*NU_STEEL/((1+NU_STEEL)*(1-2*NU_STEEL))
GS   = E_STEEL/(2*(1+NU_STEEL))
X_INERT = 1.0

! ---- PZT-4, Liu 2002 Table 1 (NOT Duan C44E=73 GPa) ----
C11E = 1.320E5
C12E = 7.100E4
C13E = 7.300E4
C33E = 1.150E5
C44E = 2.600E4          ! Liu C55E = 26 GPa (yz/xz shear)
C66E = (C11E-C12E)/2
E31  = 4.1E-3           ! +4.1 project convention (Liu print -4.1)
E33  = 1.41E-2
E15  = 1.05E-2
EPS0   = 8.854E-12
X11ABS = 7.124E-9
X33ABS = 5.841E-9
X11    = X11ABS/EPS0     ! MP,PERx RELATIVE (epsrel pitfall)
X33    = X33ABS/EPS0
RHO_PZT = 7.500E-9

/PREP7
ET,1,SOLID226
KEYOPT,1,1,1001

! Material 1: steel. ANSYS order x, y, z, xy, yz, xz.
TB,ANEL,1,1,,0
TBDATA,1,DS11,DS12,DS12,0,0,0
TBDATA,7,DS11,DS12,0,0,0
TBDATA,12,DS11,0,0,0
TBDATA,16,GS,0,0
TBDATA,19,GS,0
TBDATA,21,GS
TB,PIEZ,1
TBDATA,1,0,0,0,0,0,0
TBDATA,7,0,0,0,0,0,0
TBDATA,13,0,0,0,0,0,0
MP,PERX,1,X_INERT
MP,PERY,1,X_INERT
MP,PERZ,1,X_INERT
MP,DENS,1,RHO_STEEL

! Material 2: PZT-4, poled +Z. TB,PIEZ stress-major 6x3 (not field-major).
TB,ANEL,2,1,,0
TBDATA,1,C11E,C12E,C13E,0,0,0
TBDATA,7,C11E,C13E,0,0,0
TBDATA,12,C33E,0,0,0
TBDATA,16,C66E,0,0
TBDATA,19,C44E,0
TBDATA,21,C44E
TB,PIEZ,2
TBDATA,1,0,0,E31,0,0,E31
TBDATA,7,0,0,E33,0,0,0
TBDATA,13,0,E15,0,E15,0,0
MP,PERX,2,X11
MP,PERY,2,X11
MP,PERZ,2,X33
MP,DENS,2,RHO_PZT

! ---- geometry: three stacked half-annuli (RI_MESH), glued ----
CSYS,0
CYLIND,RI,RO,-H,H,TH1,TH2
CYLIND,RI,RO,H,H+H1,TH1,TH2
CYLIND,RI,RO,-H-H1,-H,TH1,TH2
VGLUE,ALL
*GET,NV,VOLU,0,COUNT
*IF,NV,NE,3,THEN
  *MSG,FATAL
VGLUE did not leave exactly three volumes.
*ENDIF
*GET,NLT,LINE,0,COUNT
*IF,NLT,NE,28,THEN
  *MSG,FATAL
Glued half-annulus model does not have 28 lines.
*ENDIF
VSEL,S,LOC,Z,-0.200000,0.200000
*GET,NV,VOLU,0,COUNT
*IF,NV,NE,1,THEN
  *MSG,FATAL
host volume select did not return one volume.
*ENDIF
VATT,1,,1
ALLSEL,ALL
VSEL,S,LOC,Z,10.800000,11.200000
*GET,NV,VOLU,0,COUNT
*IF,NV,NE,1,THEN
  *MSG,FATAL
top skin volume select did not return one volume.
*ENDIF
VATT,2,,1
ALLSEL,ALL
VSEL,S,LOC,Z,-11.200000,-10.800000
*GET,NV,VOLU,0,COUNT
*IF,NV,NE,1,THEN
  *MSG,FATAL
bottom skin volume select did not return one volume.
*ENDIF
VATT,2,,1
ALLSEL,ALL

! ---- line divisions (CSYS,1: LOC X is r). Parent annular pairing. ----
! Opposite edges of each 4-sided face: radials=NDIV_R, arcs=NDIV_TH.
CSYS,1
! radial lines z1
LSEL,S,LOC,X,300.500000,302.500000
LSEL,R,LOC,Z,-12.200000,-11.800000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
radial lines z1: line count was not 2.
*ENDIF
LESIZE,ALL,,,24
ALLSEL,ALL
! inner arc z1
LSEL,S,LOC,X,2.700000,3.300000
LSEL,R,LOC,Z,-12.200000,-11.800000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
inner arc z1: line count was not 1.
*ENDIF
LESIZE,ALL,,,72
ALLSEL,ALL
! outer arc z1
LSEL,S,LOC,X,599.700000,600.300000
LSEL,R,LOC,Z,-12.200000,-11.800000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
outer arc z1: line count was not 1.
*ENDIF
LESIZE,ALL,,,72
ALLSEL,ALL
! radial lines z2
LSEL,S,LOC,X,300.500000,302.500000
LSEL,R,LOC,Z,-10.200000,-9.800000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
radial lines z2: line count was not 2.
*ENDIF
LESIZE,ALL,,,24
ALLSEL,ALL
! inner arc z2
LSEL,S,LOC,X,2.700000,3.300000
LSEL,R,LOC,Z,-10.200000,-9.800000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
inner arc z2: line count was not 1.
*ENDIF
LESIZE,ALL,,,72
ALLSEL,ALL
! outer arc z2
LSEL,S,LOC,X,599.700000,600.300000
LSEL,R,LOC,Z,-10.200000,-9.800000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
outer arc z2: line count was not 1.
*ENDIF
LESIZE,ALL,,,72
ALLSEL,ALL
! radial lines z3
LSEL,S,LOC,X,300.500000,302.500000
LSEL,R,LOC,Z,9.800000,10.200000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
radial lines z3: line count was not 2.
*ENDIF
LESIZE,ALL,,,24
ALLSEL,ALL
! inner arc z3
LSEL,S,LOC,X,2.700000,3.300000
LSEL,R,LOC,Z,9.800000,10.200000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
inner arc z3: line count was not 1.
*ENDIF
LESIZE,ALL,,,72
ALLSEL,ALL
! outer arc z3
LSEL,S,LOC,X,599.700000,600.300000
LSEL,R,LOC,Z,9.800000,10.200000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
outer arc z3: line count was not 1.
*ENDIF
LESIZE,ALL,,,72
ALLSEL,ALL
! radial lines z4
LSEL,S,LOC,X,300.500000,302.500000
LSEL,R,LOC,Z,11.800000,12.200000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
radial lines z4: line count was not 2.
*ENDIF
LESIZE,ALL,,,24
ALLSEL,ALL
! inner arc z4
LSEL,S,LOC,X,2.700000,3.300000
LSEL,R,LOC,Z,11.800000,12.200000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
inner arc z4: line count was not 1.
*ENDIF
LESIZE,ALL,,,72
ALLSEL,ALL
! outer arc z4
LSEL,S,LOC,X,599.700000,600.300000
LSEL,R,LOC,Z,11.800000,12.200000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
outer arc z4: line count was not 1.
*ENDIF
LESIZE,ALL,,,72
ALLSEL,ALL
! inner thickness lines, bottom skin
LSEL,S,LOC,X,2.700000,3.300000
LSEL,R,LOC,Z,-11.200000,-10.800000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
inner thickness lines, bottom skin: line count was not 2.
*ENDIF
LESIZE,ALL,,,1
ALLSEL,ALL
! outer thickness lines, bottom skin
LSEL,S,LOC,X,599.700000,600.300000
LSEL,R,LOC,Z,-11.200000,-10.800000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
outer thickness lines, bottom skin: line count was not 2.
*ENDIF
LESIZE,ALL,,,1
ALLSEL,ALL
! inner thickness lines, host
LSEL,S,LOC,X,2.700000,3.300000
LSEL,R,LOC,Z,-0.200000,0.200000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
inner thickness lines, host: line count was not 2.
*ENDIF
LESIZE,ALL,,,2
ALLSEL,ALL
! outer thickness lines, host
LSEL,S,LOC,X,599.700000,600.300000
LSEL,R,LOC,Z,-0.200000,0.200000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
outer thickness lines, host: line count was not 2.
*ENDIF
LESIZE,ALL,,,2
ALLSEL,ALL
! inner thickness lines, top skin
LSEL,S,LOC,X,2.700000,3.300000
LSEL,R,LOC,Z,10.800000,11.200000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
inner thickness lines, top skin: line count was not 2.
*ENDIF
LESIZE,ALL,,,1
ALLSEL,ALL
! outer thickness lines, top skin
LSEL,S,LOC,X,599.700000,600.300000
LSEL,R,LOC,Z,10.800000,11.200000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
outer thickness lines, top skin: line count was not 2.
*ENDIF
LESIZE,ALL,,,1
ALLSEL,ALL
CSYS,0
ALLSEL,ALL
MSHAPE,0,3D
MSHKEY,1
VMESH,ALL
ALLSEL,ALL
NUMMRG,NODES,1.0E-5
*GET,NEL,ELEM,0,COUNT
*IF,NEL,NE,6912,THEN
  *MSG,FATAL
Mapped mesh element count does not equal the division product.
*ENDIF
ESEL,S,MAT,,2
*GET,NELP,ELEM,0,COUNT
*IF,NELP,NE,3456,THEN
  *MSG,FATAL
Piezo-skin element count is wrong.
*ENDIF
ALLSEL,ALL
*GET,NNODE,NODE,0,COUNT
FINISH

/SOLU
ANTYPE,MODAL
MODOPT,LANB,NMODES,-1.0,,,ON
MXPAND,NMODES,,,NO
CSYS,0
! symmetry plane y=0 (theta=0 and theta=180 faces): UY=0 only
NSEL,S,LOC,Y,-0.001,0.001
*GET,NSYM,NODE,0,COUNT
*IF,NSYM,NE,690,THEN
  *MSG,FATAL
Symmetry-plane node count is wrong.
*ENDIF
D,ALL,UY,0
ALLSEL,ALL
! inner hole r=RI_MESH: FREE in v2 (mesh count asserted, NO constraint)
CSYS,1
NSEL,S,LOC,X,2.990000,3.010000
CSYS,0
*GET,NIN,NODE,0,COUNT
*IF,NIN,NE,1017,THEN
  *MSG,FATAL
Inner-hole node count is wrong.
*ENDIF
ALLSEL,ALL
! ---- outer mechanical BC ----
! Outer clamped: all U = 0 on the outer cylindrical surface (r=RO).
CSYS,1
NSEL,S,LOC,X,599.990000,600.010000
CSYS,0
*GET,NCL,NODE,0,COUNT
*IF,NCL,LT,10,THEN
  *MSG,FATAL
Outer clamp node select returned fewer than 10 nodes.
*ENDIF
D,ALL,UX,0
D,ALL,UY,0
D,ALL,UZ,0
ALLSEL,ALL
! ---- electrical BC: both-faces SC (scboth / nge1 sc pattern) ----
! VOLT=0 on host/piezo interfaces AND on both outer faces. No CP.
NSEL,S,LOC,Z,9.990000,10.010000
NSEL,A,LOC,Z,-10.010000,-9.990000
*GET,NINT,NODE,0,COUNT
*IF,NINT,NE,10754,THEN
  *MSG,FATAL
Interface electrode node count is wrong.
*ENDIF
D,ALL,VOLT,0
ALLSEL,ALL
NSEL,S,LOC,Z,11.990000,12.010000
NSEL,A,LOC,Z,-12.010000,-11.990000
*GET,NOUT,NODE,0,COUNT
*IF,NOUT,NE,10754,THEN
  *MSG,FATAL
Outer electrode node count is wrong.
*ENDIF
D,ALL,VOLT,0
ALLSEL,ALL
SOLVE
FINISH

/POST1
*DIM,FR1,ARRAY,NMODES
*DIM,IDXARR,ARRAY,NMODES
*DO,I,1,NMODES
  *GET,FR1(I),MODE,I,FREQ
  IDXARR(I)=I
*ENDDO
*CFOPEN,ansys_p4_liudisk2_sc_C_modes,txt
*VWRITE
('tag liu_disk_sc_C')
*VWRITE,NEL
('elements ', F12.0)
*VWRITE,NNODE
('nodes ', F12.0)
*VWRITE,NSYM
('symmetry_nodes ', F12.0)
*VWRITE,NINT
('interface_nodes ', F12.0)
*VWRITE,NOUT
('outer_nodes ', F12.0)
*VWRITE
('mode f_Hz')
*VWRITE,IDXARR(1),FR1(1)
(F4.0, 3X, E20.12)
*CFCLOS

