TBDATA,7,0,E31,0,E15,0,0
TBDATA,13,0,0,E15,0,0,0
MP,PERX,1,X11
MP,PERY,1,X33
MP,PERZ,1,X11
MP,DENS,1,RHO_PZT

RECTNG,RI,RO,-H,H
ASEL,S,AREA,,1
AATT,1,,1
LSLA,S
LSEL,R,LOC,X,RI
LESIZE,ALL,,,NDIV_Z,,,,,1
