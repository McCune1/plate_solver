/POST1
*DIM, MIDX, ARRAY, NMODES
*VFILL, MIDX, RAMP, 1, 1
*DIM, FRA, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FRA(I), MODE, I, FREQ
*ENDDO
*CFOPEN, p1_cant_ip_r125_a025_mesh192, txt
*VWRITE
('mode      f[Hz]    (PLANE183 192x192 plane stress, cantilever IP, r125 a025, nu=0.35)')
*VWRITE, MIDX(1), FRA(1)
(F4.0, 3X, E18.10)
*CFCLOS
FINISH
