FINISH
/CLEAR,NOSTART
/TITLE, Paper 4 F-F piezo ring EPSREL HARMIC driven Y v2 CHRG dump, p=0, h1/2h=1/12 (2026-09-16)

! ---- Geometry (SI units, meters) ----
RI     = 100.0
RO     = 600.0
H      = 10.0           ! host HALF-thickness [mm] (Duan2005's own h symbol)
H1     = 2*H/12         ! piezo layer thickness, Table-4 ratio 1/12
NDIV_R = 40
NDIV_ZH = 6              ! through-thickness divisions, host
NDIV_ZP = 2              ! through-thickness divisions, each piezo layer
NMODES = 20

! ---- Steel host material (elastic only) ----
E_STEEL   = 2.00E5      ! [MPa] = 200 GPa
NU_STEEL  = 0.3
RHO_STEEL = 7.800E-9    ! [tonne/mm^3]

! ---- PZT4 piezo material, Duan2005 Table 1, IEEE z-poled convention ----
C11E = 1.320E5          ! [MPa]
C12E = 7.100E4          ! [MPa]
C13E = 7.300E4          ! [MPa]
C33E = 1.150E5          ! [MPa]
C44E = 7.300E4          ! [MPa]
C66E = (C11E-C12E)/2
E31  = -4.1E-3           ! [C/mm^2-equivalent, N/(V*mm)] (C/m^2 -> x1e-3, see units header)    ! e31 SIGN CLONE: was +4.1E-3
E33  = 1.41E-2          ! (x1e-3)
E15  = 1.05E-2          ! (x1e-3)
EPS0   = 8.854E-12       ! F/m. PLANE223 MP,PERx is RELATIVE, not absolute.
X11ABS = 7.124E-9        ! Duan2005 Table 1 absolute F/m
X33ABS = 5.841E-9
X11    = X11ABS/EPS0     ! ~804.8 relative
X33    = X33ABS/EPS0     ! ~659.7 relative
RHO_PZT = 7.500E-9      ! [tonne/mm^3]

! Nominal inert permittivity for the steel region -- NOT physical, only
! keeps VOLT well-posed there (see header). The steel material's own
! TB,PIEZ block is all-zero (e=0), so X_INERT's VALUE cannot mechanically
! couple to anything regardless of scale -- only VOLT-dof conditioning is
! affected. FIX v4 2026-09-15 (LESSONS_LEARNED Sec 18.154, following the
! bare-host isolation deck's DECISIVE clean result, job 2490363, which
! ruled out geometry/meshing/free-free-BC entirely and narrowed the
! search to this permittivity scale): raised from 1.0E-15 to 1.0E-9,
! the SAME ORDER OF MAGNITUDE as the real PZT4 values (X11=7.124E-9,
! X33=5.841E-9) instead of ~6-7 orders of magnitude below them. ANSYS's
! own coupled-field modeling guidance for an inert region sharing a mesh
! with a real piezo material is that the inert permittivity should not
! be many orders of magnitude smaller than the surrounding material,
! since that scale mismatch is a textbook cause of the Block-Lanczos
! ill-conditioning warning seen in job 2490350 ("relative residual from
! test linear solve: 9.147498E-02"). NOT YET RE-RUN -- see Sec 18.154
! for the full pre-registered confirmation criteria.
X_INERT = 1.0           ! relative (host VOLT well-posed). Was 1.0E-9 fed as if absolute.

!
! ============================================================
! EPSREL FIX (2026-09-16): PLANE223 MP,PERx is RELATIVE permittivity.
! Duan2005 Table 1 X11=7.124e-9 / X33=5.841e-9 are ABSOLUTE (F/m =
! eps_r * eps0). Parent UNITS_MM decks fed those F/m numbers to MP,PERX
! unchanged. Coupled-Field Guide 2.3.2.1: for PLANE223, MP,PERX and
! TB,DPER are ALWAYS relative. The SOLID5/SOLID98 "value<1 means
! absolute" exception does NOT apply. Default EPZRO is left alone
! (8.85e-12 F/m); relative ~805 * EPZRO recovers the Duan absolute
! value, which is also the correct mm-N-s-tonne number (permittivity
! is numerically invariant under that rescale). Host X_INERT is now a
! small relative value (1.0), not 1.0E-9-fed-as-relative. NOTHING else
! in the mesh, TB,PIEZ FIX v6, units, or electrical BC is changed
! unless a deck's own name says so (subsp / e0 / cc).
! ============================================================
/PREP7
ET,1,PLANE223
KEYOPT,1,1,1001    ! structural-piezoelectric dof set (Table 223.2, sourced Sec 18.144)
KEYOPT,1,3,1       ! axisymmetric (sourced Sec 18.144)

! ---- Material 1: steel host, elastic only, inert electrical props ----
TB,ANEL,1,1,,0
TBDATA,1, (E_STEEL*(1-NU_STEEL)/((1+NU_STEEL)*(1-2*NU_STEEL))), (E_STEEL*NU_STEEL/((1+NU_STEEL)*(1-2*NU_STEEL))), (E_STEEL*NU_STEEL/((1+NU_STEEL)*(1-2*NU_STEEL))),0,0,0
TBDATA,7, (E_STEEL*(1-NU_STEEL)/((1+NU_STEEL)*(1-2*NU_STEEL))), (E_STEEL*NU_STEEL/((1+NU_STEEL)*(1-2*NU_STEEL))),0,0,0
TBDATA,12,(E_STEEL*(1-NU_STEEL)/((1+NU_STEEL)*(1-2*NU_STEEL))),0,0,0
TBDATA,16,(E_STEEL/(2*(1+NU_STEEL))),0,0
TBDATA,19,(E_STEEL/(2*(1+NU_STEEL))),0
TBDATA,21,(E_STEEL/(2*(1+NU_STEEL)))
TB,PIEZ,1
TBDATA,1,0,0,0,0,0,0
TBDATA,7,0,0,0,0,0,0
TBDATA,13,0,0,0,0,0,0
MP,PERX,1,X_INERT
MP,PERY,1,X_INERT
MP,PERZ,1,X_INERT
MP,DENS,1,RHO_STEEL

! ---- Material 2: PZT4 piezo layer (identical to the confirmed-working
! disk smoke deck's own material block -- ansys_piezo_disk_modal_
! plane223.inp -- copied unchanged, same axis-mapping citations apply) ----
TB,ANEL,2,1,,0
TBDATA,1,C11E,C13E,C12E,0,0,0
TBDATA,7,C33E,C13E,0,0,0
TBDATA,12,C11E,0,0,0
TBDATA,16,C44E,0,0
TBDATA,19,C66E,0
TBDATA,21,C44E
TB,PIEZ,2
TBDATA,1,0,E31,0,0,E33,0
TBDATA,7,0,E31,0,E15,0,0
TBDATA,13,0,0,E15,0,0,0
MP,PERX,2,X11
MP,PERY,2,X33
MP,PERZ,2,X11
MP,DENS,2,RHO_PZT

! ---- Geometry: three stacked rectangles (r x z), host + top/bottom piezo ----
RECTNG,RI,RO,-H,H              ! area 1: steel host
RECTNG,RI,RO,H,H+H1            ! area 2: piezo top
RECTNG,RI,RO,-H-H1,-H          ! area 3: piezo bottom

! FIX v2 2026-09-15 (job 2490219 post-mortem -- v1 fix above was diagnosed
! wrong): the TRUE bug is that LSEL,,LOC,... is a GLOBAL, area-UNSCOPED
! select -- at X=RI/X=RO/Y=H etc, it matches every line at that coordinate
! across ALL THREE stacked areas (their edges are coincident/touching by
! construction), not just the area currently being processed. Area 1's
! block (run first) ends up setting NDIV=6 on ALL SIX vertical lines in
! the model, including area 2/3's own -- so when area 2/3's blocks later
! try LESIZE,...,NDIV_ZP(=2) on their vertical edges, LESIZE's default
! KFORCE=0 silently REFUSES to change an already-nonzero division ("
! PREVIOUS NONZERO VALUES WILL NOT BE ALTERED", confirmed in job 2490219's
! own log) -- NDIV_ZP never actually takes effect on either piezo layer,
! both stay at NDIV=6. Combined with the (correctly working) NDIV_R=40
! radial sizing, that's 40 x 6 = 240 elements/layer at aspect ratio 45 --
! exactly what both job 2489625 and 2490219 produced, unchanged, because
! the v1 fix touched the radial dimension, which was never the broken one.
! REAL FIX: scope every LSEL to the CURRENTLY SELECTED AREA's own lines
! via LSLA,S (lines belonging to selected areas) before refining by LOC,
! so no area's block can ever touch another area's lines -- eliminates the
! whole KFORCE cross-contamination class, not just this one instance.
! FIX v3 2026-09-15 (job 2490239 post-mortem -- v2 fix above was STILL
! wrong, confirmed by a THIRD byte-identical result). Root cause, this
! time confirmed directly against the log's own selection-count lines,
! not inferred: LSLA,S + LSEL,R correctly scopes the FIRST line of each
! pair to the current area (verified: "4 LINES...1 SELECTED AREAS BY LSLA"
! then "1 LINE...SELECTED BY LSEL" for the R-type reselect). But the
! SECOND line of each pair used LSEL,A ("ALSO SELECT") -- and A-type is a
! UNION WITH THE FULL DATABASE, not an intersect within whatever LSLA had
! scoped -- it is NOT constrained by the preceding LSLA,S at all. So
! area 1's block (run first) still globally swept every area's RO-edge
! line via its own LSEL,A,LOC,X,RO and set them ALL to NDIV_ZH=6 --
! including area 2's and area 3's own outer vertical edges, before either
! area had been touched. When area 2/3's own blocks later tried
! LESIZE,...,NDIV_ZP=2 on those same (now-already-6) RO lines, KFORCE=0
! silently blocked it (confirmed in the log). Net effect unchanged from
! v1/v2: both piezo layers still mesh at an effective 40(radial) x
! 6(thru, stuck) = 240 elements, AR=45.
! REAL FIX: never use LSEL,A (or any global LOC-based select) anywhere in
! this block. Every line is now sized by its OWN single-line LSLA,S +
! LSEL,R + LESIZE sequence -- four separate calls per area instead of two
! combined ones -- so no selection ever reaches outside the lines already
! scoped to the current area, and the A-type leak this class of bug
! depends on never occurs.
ASEL,S,AREA,,1
AATT,1,,1
LSLA,S
LSEL,R,LOC,X,RI
LESIZE,ALL,,,NDIV_ZH,,,,,1
LSLA,S
LSEL,R,LOC,X,RO
LESIZE,ALL,,,NDIV_ZH,,,,,1
LSLA,S
LSEL,R,LOC,Y,-H
LESIZE,ALL,,,NDIV_R,,,,,1
LSLA,S
LSEL,R,LOC,Y,H
LESIZE,ALL,,,NDIV_R,,,,,1
ALLSEL,ALL
ASEL,S,AREA,,1
MSHAPE,0,2D
MSHKEY,1
AMESH,ALL

ASEL,S,AREA,,2
AATT,2,,1
LSLA,S
LSEL,R,LOC,X,RI
LESIZE,ALL,,,NDIV_ZP,,,,,1
LSLA,S
LSEL,R,LOC,X,RO
LESIZE,ALL,,,NDIV_ZP,,,,,1
LSLA,S
LSEL,R,LOC,Y,H
LESIZE,ALL,,,NDIV_R,,,,,1
LSLA,S
LSEL,R,LOC,Y,H+H1
LESIZE,ALL,,,NDIV_R,,,,,1
ALLSEL,ALL
ASEL,S,AREA,,2
MSHAPE,0,2D
MSHKEY,1
AMESH,ALL

ASEL,S,AREA,,3
AATT,2,,1
LSLA,S
LSEL,R,LOC,X,RI
LESIZE,ALL,,,NDIV_ZP,,,,,1
LSLA,S
LSEL,R,LOC,X,RO
LESIZE,ALL,,,NDIV_ZP,,,,,1
LSLA,S
LSEL,R,LOC,Y,-H-H1
LESIZE,ALL,,,NDIV_R,,,,,1
LSLA,S
LSEL,R,LOC,Y,-H
LESIZE,ALL,,,NDIV_R,,,,,1
ALLSEL,ALL
ASEL,S,AREA,,3
MSHAPE,0,2D
MSHKEY,1
AMESH,ALL

ALLSEL,ALL
NUMMRG,NODES,1.0E-5     ! merge coincident nodes at the host/piezo interfaces [mm tolerance, was 1.0E-8 m]
                          ! (areas meshed separately above -- this is the
                          ! step that actually bonds them; if AMESH left
                          ! non-coincident interface nodes for any reason
                          ! this is what fixes it, cheap insurance)
FINISH

/SOLU
! Lever 9 v2. Same HARMIC / mesh / HARFRQ as job 2494669. Isolated
! dump fix: KEYOPT(1)=1001 force label is CHRG not AMPS; OUTRES,RSOL
! so reactions are on the rst; CP outer bus and D the master only so
! one node carries the total electrode charge. Do not retune mesh,
! units, TB,PIEZ, DMPRAT, or the frequency window.
ANTYPE,HARMIC
HROPT,FULL
HROUT,OFF
OUTRES,NSOL,ALL
OUTRES,RSOL,ALL
DMPRAT,1.0E-4
KBC,1
EQSLV,SPARSE

NSEL,S,LOC,Y,H
NSEL,A,LOC,Y,-H
D,ALL,VOLT,0
ALLSEL,ALL
NSEL,S,LOC,Y,H+H1
NSEL,A,LOC,Y,-H-H1
CP,1,VOLT,ALL
*GET,NMAST,NODE,0,NUM,MIN
D,NMAST,VOLT,1.0
ALLSEL,ALL

HARFRQ,118.50,120.20
NSUBST,35
LSWRITE,1

HARFRQ,80.0,80.0
NSUBST,1
LSWRITE,2

HARFRQ,140.0,140.0
NSUBST,1
LSWRITE,3

LSSOLVE,1,3
FINISH

/POST1
! KEYOPT(1)=1001 -> VOLT reaction label is CHRG (charge). For V=1,
! Ceff=Q and |Y|=omega*|Q|. Pole/zero frequencies of Q and Y coincide
! for omega!=0. Read the CSV, never the queue script's own label.
! One PRRSOL at the first dense substep so a human can see the label
! if *GET ever fails again.
SET,1,1,,0
NSEL,S,NODE,,NMAST
PRRSOL,CHRG
ALLSEL,ALL

NROW=37
*DIM,LSARR,ARRAY,NROW
*DIM,SBARR,ARRAY,NROW
*DIM,FRARR,ARRAY,NROW
*DIM,QREARR,ARRAY,NROW
*DIM,QIMARR,ARRAY,NROW
*DIM,YARR,ARRAY,NROW
*DIM,LSLIST,ARRAY,3
*DIM,NSBLIST,ARRAY,3
LSLIST(1)=1
LSLIST(2)=2
LSLIST(3)=3
NSBLIST(1)=35
NSBLIST(2)=1
NSBLIST(3)=1
K=0
*DO,IL,1,3
  LSNOW=LSLIST(IL)
  NSB=NSBLIST(IL)
  *DO,ISB,1,NSB
    K=K+1
    SET,LSNOW,ISB,,0
    *GET,FREQV,ACTIVE,0,SET,FREQ
    *GET,QREAC,NODE,NMAST,RF,CHRG
    SET,LSNOW,ISB,,1
    *GET,QIMAG,NODE,NMAST,RF,CHRG
    OMEGA=2*3.141592653589793*FREQV
    QABS=SQRT(QREAC*QREAC+QIMAG*QIMAG)
    LSARR(K)=LSNOW
    SBARR(K)=ISB
    FRARR(K)=FREQV
    QREARR(K)=QREAC
    QIMARR(K)=QIMAG
    YARR(K)=OMEGA*QABS
  *ENDDO
*ENDDO
*CFOPEN,ansys_p4_harm_ff_y_v2_h112_sweep_e31m,csv
*VWRITE
('ls,sb,freq_Hz,Qre,Qim,Yabs')
*VWRITE,LSARR(1),SBARR(1),FRARR(1),QREARR(1),QIMARR(1),YARR(1)
(F4.0,',',F4.0,',',E16.8,',',E16.8,',',E16.8,',',E16.8)
*CFCLOS
FINISH
