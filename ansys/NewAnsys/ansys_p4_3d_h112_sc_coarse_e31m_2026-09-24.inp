! ansys_p4_3d_h112_sc_coarse_e31m_2026-09-24.inp
! e31 SIGN CLONE (2026-09-24, clone_e31m_decks_2026-09-24.py, LESSONS Sec 18.244).
! Parent: ansys_p4_3d_h112_sc_coarse_2026-09-23.inp. Only changes: E31 = -4.1E-3 (Liu 2002 / Duan 2005
! Table 1 as printed) and every *CFOPEN output name + '_e31m'.
! Targets quoted in the parent header below are the OLD +4.1 values.
! Do not put the MAPDL failure token in this file.
! ansys_p4_3d_h112_sc_coarse_2026-09-23.inp
! Paper 4 -- 3-D FE check of coupled n >= 1 F-F roots (FUTURE_WORK.md).
! Built by build_p4_3d_nge1_decks_2026-09-23.py. Do not hand-edit; rebuild.
! Layered F-F annulus, SOLID226 (KEYOPT(1)=1001), HALF model theta=0..180,
! UY=0 on y=0 (cos(n theta) family). h1/2h = 1/12. Case: both-faces short circuit, VOLT=0 on interfaces and outers.
! Mesh coarse: 24 radial x 72 circ x (2 host + 1 + 1 skins) = 6912 elements.
! Units mm-N-s-tonne, real volts, RELATIVE permittivity (epsrel decks).
! Poling +Z in both skins (same-poling parallel bimorph, paper Eq. Mp).
! Prints raw Hz and raw UX/UY/UZ/VOLT at 78 sample nodes only.
! Score with score_p4_3d_nge1_2026-09-23.py. Never trust .QUEUE_OK alone.
! ============================================================
FINISH
/CLEAR,NOSTART
/TITLE, Paper 4 3-D half ring SOLID226 sc coarse h1/2h=1/12 (2026-09-23)

RI     = 100.0
RO     = 600.0
H      = 10.0           ! host HALF-thickness [mm]
H1     = 2*H/12          ! skin thickness [mm]
TH1    = 0.0
TH2    = 180.0
NDIV_R = 24
NDIV_TH = 72
NDIV_ZH = 2
NDIV_ZP = 1
NMODES = 24

! ---- steel host (TB,ANEL numbers as the PLANE223 epsrel decks) ----
E_STEEL   = 2.00E5
NU_STEEL  = 0.3
RHO_STEEL = 7.800E-9
DS11 = E_STEEL*(1-NU_STEEL)/((1+NU_STEEL)*(1-2*NU_STEEL))
DS12 = E_STEEL*NU_STEEL/((1+NU_STEEL)*(1-2*NU_STEEL))
GS   = E_STEEL/(2*(1+NU_STEEL))
X_INERT = 1.0

! ---- PZT-4, Duan 2005 Table 1 (as every Paper 4 deck) ----
C11E = 1.320E5
C12E = 7.100E4
C13E = 7.300E4
C33E = 1.150E5
C44E = 7.300E4
C66E = (C11E-C12E)/2
E31  = -4.1E-3    ! e31 SIGN CLONE: was +4.1E-3
E33  = 1.41E-2
E15  = 1.05E-2
EPS0   = 8.854E-12
X11ABS = 7.124E-9
X33ABS = 5.841E-9
X11    = X11ABS/EPS0
X33    = X33ABS/EPS0
RHO_PZT = 7.500E-9

/PREP7
ET,1,SOLID226
KEYOPT,1,1,1001

! Material 1: steel. ANSYS order x, y, z, xy, yz, xz.
TB,ANEL,1,1,,0
TBDATA,1,DS11,DS12,DS12,0,0,0
TBDATA,7,DS11,DS12,0,0,0
TBDATA,12,DS11,0,0,0
TBDATA,16,GS,0,0
TBDATA,19,GS,0
TBDATA,21,GS
TB,PIEZ,1
TBDATA,1,0,0,0,0,0,0
TBDATA,7,0,0,0,0,0,0
TBDATA,13,0,0,0,0,0,0
MP,PERX,1,X_INERT
MP,PERY,1,X_INERT
MP,PERZ,1,X_INERT
MP,DENS,1,RHO_STEEL

! Material 2: PZT-4, poled +Z (Paper 6 SOLID226 block).
TB,ANEL,2,1,,0
TBDATA,1,C11E,C12E,C13E,0,0,0
TBDATA,7,C11E,C13E,0,0,0
TBDATA,12,C33E,0,0,0
TBDATA,16,C66E,0,0
TBDATA,19,C44E,0
TBDATA,21,C44E
TB,PIEZ,2
TBDATA,1,0,0,E31,0,0,E31
TBDATA,7,0,0,E33,0,0,0
TBDATA,13,0,E15,0,E15,0,0
MP,PERX,2,X11
MP,PERY,2,X11
MP,PERZ,2,X33
MP,DENS,2,RHO_PZT

! ---- geometry: three stacked half-annulus volumes, glued ----
CSYS,0
CYLIND,RI,RO,-H,H,TH1,TH2
CYLIND,RI,RO,H,H+H1,TH1,TH2
CYLIND,RI,RO,-H-H1,-H,TH1,TH2
VGLUE,ALL
*GET,NV,VOLU,0,COUNT
*IF,NV,NE,3,THEN
  *MSG,FATAL
VGLUE did not leave exactly three volumes.
*ENDIF
*GET,NLT,LINE,0,COUNT
*IF,NLT,NE,28,THEN
  *MSG,FATAL
Glued model does not have 28 lines.
*ENDIF
VSEL,S,LOC,Z,-0.166667,0.166667
*GET,NV,VOLU,0,COUNT
*IF,NV,NE,1,THEN
  *MSG,FATAL
host volume select did not return one volume.
*ENDIF
VATT,1,,1
ALLSEL,ALL
VSEL,S,LOC,Z,10.666667,11.000000
*GET,NV,VOLU,0,COUNT
*IF,NV,NE,1,THEN
  *MSG,FATAL
top skin volume select did not return one volume.
*ENDIF
VATT,2,,1
ALLSEL,ALL
VSEL,S,LOC,Z,-11.000000,-10.666667
*GET,NV,VOLU,0,COUNT
*IF,NV,NE,1,THEN
  *MSG,FATAL
bottom skin volume select did not return one volume.
*ENDIF
VATT,2,,1
ALLSEL,ALL

! ---- line divisions (CSYS,1: LOC X is r) ----
CSYS,1
! radial lines z1
LSEL,S,LOC,X,349.000000,351.000000
LSEL,R,LOC,Z,-11.833333,-11.500000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
radial lines z1: line count was not 2.
*ENDIF
LESIZE,ALL,,,24
