STOL = 0.01
CSYS,0
*DO,K,1,NSAMP
  X1 = SX(K)-STOL
  X2 = SX(K)+STOL
  Y1 = SY(K)-STOL
  Y2 = SY(K)+STOL
  Z1 = SZ(K)-STOL
  Z2 = SZ(K)+STOL
  NSEL,S,LOC,X,X1,X2
  NSEL,R,LOC,Y,Y1,Y2
  NSEL,R,LOC,Z,Z1,Z2
  *GET,NC,NODE,0,COUNT
  *IF,NC,NE,1,THEN
    *MSG,FATAL
Sample node select did not return exactly one node.
  *ENDIF
  *GET,NN,NODE,0,NUM,MIN
  NS(K) = NN
*ENDDO
ALLSEL,ALL
*CFOPEN,ansys_p4_3d_h112_sc_coarse_samplecoords_e31m,txt
*VWRITE
('k r_mm theta_deg z_mm node')
*VWRITE,SKI(1),SR(1),ST(1),SZ(1),NS(1)
(F5.0, 3X, F10.3, 3X, F10.3, 3X, F10.4, 3X, F10.0)
*CFCLOS

! ---- raw nodal values, every mode x every sample, flat arrays ----
NTOT = NMODES*NSAMP
*DIM,OMI,ARRAY,NTOT
*DIM,OKI,ARRAY,NTOT
*DIM,OUX,ARRAY,NTOT
*DIM,OUY,ARRAY,NTOT
*DIM,OUZ,ARRAY,NTOT
*DIM,OVV,ARRAY,NTOT
*DO,I,1,NMODES
  SET,1,I
  *DO,K,1,NSAMP
    J = (I-1)*NSAMP+K
    NN = NS(K)
    *GET,GVX,NODE,NN,U,X
    *GET,GVY,NODE,NN,U,Y
    *GET,GVZ,NODE,NN,U,Z
    *GET,GVV,NODE,NN,VOLT
    OMI(J) = I
    OKI(J) = K
    OUX(J) = GVX
    OUY(J) = GVY
    OUZ(J) = GVZ
    OVV(J) = GVV
  *ENDDO
*ENDDO
*CFOPEN,ansys_p4_3d_h112_sc_coarse_samples_e31m,txt
*VWRITE
('mode k UX UY UZ VOLT')
*VWRITE,OMI(1),OKI(1),OUX(1),OUY(1),OUZ(1),OVV(1)
(F4.0, 1X, F5.0, 1X, E16.8, 1X, E16.8, 1X, E16.8, 1X, E16.8)
*CFCLOS
FINISH
