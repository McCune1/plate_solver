('symmetry_nodes ', F12.0)
*VWRITE,NINT
('interface_nodes ', F12.0)
*VWRITE,NOUT
('outer_nodes ', F12.0)
*VWRITE
('mode f_Hz')
*VWRITE,IDXARR(1),FR1(1)
(F4.0, 3X, E20.12)
