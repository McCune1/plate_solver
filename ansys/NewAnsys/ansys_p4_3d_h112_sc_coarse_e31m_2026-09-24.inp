CSYS,0
ALLSEL,ALL
MSHAPE,0,3D
MSHKEY,1
VMESH,ALL
ALLSEL,ALL
*GET,NEL,ELEM,0,COUNT
*IF,NEL,NE,6912,THEN
  *MSG,FATAL
Mapped mesh element count does not equal the division product.
*ENDIF
ESEL,S,MAT,,2
*GET,NELP,ELEM,0,COUNT
*IF,NELP,NE,3456,THEN
  *MSG,FATAL
Piezo-skin element count is wrong.
*ENDIF
ALLSEL,ALL
*GET,NNODE,NODE,0,COUNT
FINISH

/SOLU
ANTYPE,MODAL
MODOPT,LANB,NMODES,-1.0,,,ON
MXPAND,NMODES,,,NO
CSYS,0
! symmetry plane y=0 (theta=0 and theta=180 faces): UY=0 only
NSEL,S,LOC,Y,-0.001,0.001
*GET,NSYM,NODE,0,COUNT
*IF,NSYM,NE,690,THEN
  *MSG,FATAL
Symmetry-plane node count is wrong.
*ENDIF
D,ALL,UY,0
ALLSEL,ALL
! inner electrodes (host/skin interfaces) grounded in every case
NSEL,S,LOC,Z,9.990000,10.010000
NSEL,A,LOC,Z,-10.010000,-9.990000
*GET,NINT,NODE,0,COUNT
*IF,NINT,NE,10754,THEN
  *MSG,FATAL
Interface electrode node count is wrong.
*ENDIF
D,ALL,VOLT,0
ALLSEL,ALL
! outer electrodes z = +-(H+H1)
NSEL,S,LOC,Z,11.656667,11.676667
NSEL,A,LOC,Z,-11.676667,-11.656667
*GET,NOUT,NODE,0,COUNT
*IF,NOUT,NE,10754,THEN
  *MSG,FATAL
Outer electrode node count is wrong.
*ENDIF
D,ALL,VOLT,0
ALLSEL,ALL
SOLVE
FINISH

/POST1
*DIM,FR1,ARRAY,NMODES
*DIM,IDXARR,ARRAY,NMODES
*DO,I,1,NMODES
  *GET,FR1(I),MODE,I,FREQ
  IDXARR(I)=I
*ENDDO
*CFOPEN,ansys_p4_3d_h112_sc_coarse_modes_e31m,txt
*VWRITE
('tag h112_sc_coarse')
*VWRITE,NEL
('elements ', F12.0)
*VWRITE,NNODE
('nodes ', F12.0)
