*ENDDO
*CFOPEN,ansys_p4_3d_bare_t20_xfine_modes,txt
*VWRITE
('tag bare_t20_xfine')
*VWRITE,NEL
('elements ', F12.0)
*VWRITE,NNODE
('nodes ', F12.0)
*VWRITE,NSYM
('symmetry_nodes ', F12.0)
*VWRITE
('mode f_Hz')
*VWRITE,IDXARR(1),FR1(1)
