! ansys_p4_3d_bare_t20_xfine_2026-09-23.inp
! Paper 4 -- 3-D thin-limit check for the G3 FAIL of job 2530423.
! Built by build_p4_3d_thinlimit_decks_2026-09-23.py. Do not hand-edit; rebuild.
! Bare steel F-F half annulus, SOLID186 full integration, theta=0..180,
! UY=0 on y=0 (cos(n theta) family). Thickness t = 20 mm.
! Mesh xfine: 96 radial x 288 circ x 8 thick = 221184 elements.
! Units mm-N-s-tonne. Prints raw Hz and raw UX/UY/UZ at 78 sample nodes.
! Score with score_p4_3d_thinlimit_2026-09-23.py. Never trust .QUEUE_OK alone.
! ============================================================
FINISH
/CLEAR,NOSTART
/TITLE, Paper 4 thin-limit bare steel half ring t=20mm xfine (2026-09-23)

RI     = 100.0
RO     = 600.0
T      = 20.0           ! full thickness [mm]
TH1    = 0.0
TH2    = 180.0
NMODES = 24
E_STEEL   = 2.00E5
NU_STEEL  = 0.3
RHO_STEEL = 7.800E-9

/PREP7
ET,1,SOLID186
KEYOPT,1,2,1        ! full integration
MP,EX,1,E_STEEL
MP,NUXY,1,NU_STEEL
MP,DENS,1,RHO_STEEL
CSYS,0
CYLIND,RI,RO,-T/2,T/2,TH1,TH2
*GET,NV,VOLU,0,COUNT
*IF,NV,NE,1,THEN
  *MSG,FATAL
CYLIND did not create exactly one volume.
*ENDIF
*GET,NLT,LINE,0,COUNT
*IF,NLT,NE,12,THEN
  *MSG,FATAL
Volume does not have 12 lines.
*ENDIF
VSEL,ALL
VATT,1,,1
ALLSEL,ALL
CSYS,1
! radial lines z1
LSEL,S,LOC,X,349.000000,351.000000
LSEL,R,LOC,Z,-12.000000,-8.000000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
radial lines z1: line count was not 2.
*ENDIF
LESIZE,ALL,,,96
ALLSEL,ALL
! inner arc z1
LSEL,S,LOC,X,99.700000,100.300000
LSEL,R,LOC,Z,-12.000000,-8.000000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
inner arc z1: line count was not 1.
*ENDIF
LESIZE,ALL,,,288
ALLSEL,ALL
! outer arc z1
LSEL,S,LOC,X,599.700000,600.300000
LSEL,R,LOC,Z,-12.000000,-8.000000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
outer arc z1: line count was not 1.
*ENDIF
LESIZE,ALL,,,288
ALLSEL,ALL
! radial lines z2
LSEL,S,LOC,X,349.000000,351.000000
LSEL,R,LOC,Z,8.000000,12.000000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
radial lines z2: line count was not 2.
*ENDIF
LESIZE,ALL,,,96
ALLSEL,ALL
! inner arc z2
LSEL,S,LOC,X,99.700000,100.300000
LSEL,R,LOC,Z,8.000000,12.000000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
inner arc z2: line count was not 1.
*ENDIF
LESIZE,ALL,,,288
ALLSEL,ALL
! outer arc z2
LSEL,S,LOC,X,599.700000,600.300000
LSEL,R,LOC,Z,8.000000,12.000000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,1,THEN
  *MSG,FATAL
outer arc z2: line count was not 1.
*ENDIF
LESIZE,ALL,,,288
ALLSEL,ALL
! inner thickness lines
LSEL,S,LOC,X,99.700000,100.300000
LSEL,R,LOC,Z,-2.000000,2.000000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
inner thickness lines: line count was not 2.
*ENDIF
LESIZE,ALL,,,8
ALLSEL,ALL
! outer thickness lines
LSEL,S,LOC,X,599.700000,600.300000
LSEL,R,LOC,Z,-2.000000,2.000000
*GET,NL,LINE,0,COUNT
*IF,NL,NE,2,THEN
  *MSG,FATAL
outer thickness lines: line count was not 2.
*ENDIF
LESIZE,ALL,,,8
ALLSEL,ALL
CSYS,0
ALLSEL,ALL
MSHAPE,0,3D
MSHKEY,1
VMESH,ALL
ALLSEL,ALL
*GET,NEL,ELEM,0,COUNT
*IF,NEL,NE,221184,THEN
  *MSG,FATAL
Mapped mesh element count does not equal the division product.
*ENDIF
*GET,NNODE,NODE,0,COUNT
FINISH

/SOLU
ANTYPE,MODAL
MODOPT,LANB,NMODES,-1.0,,,ON
MXPAND,NMODES,,,NO
CSYS,0
NSEL,S,LOC,Y,-0.001,0.001
*GET,NSYM,NODE,0,COUNT
*IF,NSYM,NE,5026,THEN
  *MSG,FATAL
Symmetry-plane node count is wrong.
*ENDIF
D,ALL,UY,0
ALLSEL,ALL
SOLVE
FINISH

/POST1
*DIM,FR1,ARRAY,NMODES
*DIM,IDXARR,ARRAY,NMODES
*DO,I,1,NMODES
  *GET,FR1(I),MODE,I,FREQ
