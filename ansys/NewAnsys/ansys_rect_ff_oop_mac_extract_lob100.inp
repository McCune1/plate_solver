*CFOPEN, rect_ff_oop_mac_symm_m4_lob100, txt
*VWRITE
('X               Y               UZ')
*VWRITE, NRX(1), NRY(1), UZW(1)
(F10.5, 3X, F10.5, 3X, E14.6)
*CFCLOS

SET, 1, 5
