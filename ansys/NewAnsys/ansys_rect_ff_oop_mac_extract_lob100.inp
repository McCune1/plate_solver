L      = LOB*B
H      = 0.04
E_iso  = 210.0e9
NU_iso = 0.3
RHO    = 7800.0
NDIVX  = 60
NDIVY  = 30
NMODES = 20
PI     = 3.14159265358979

/PREP7
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
RECTNG, -L, L, 0, B
TYPE,1 $ SECNUM,1 $ MAT,1
