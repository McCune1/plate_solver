('mode       f_Hz              Lambda_FE   (ASYM=ANTI parity, l/b=1, SHELL281 mesh2)')
*VWRITE, MIDX(1), FRQ(1), LAM(1)
(F8.0, 3X, E16.8, 3X, F12.6)
*CFCLOS

