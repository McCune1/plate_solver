! ===========================================================================
!  ansys_ff_isoval_mesh80.inp  --  Mechanical APDL batch deck
!  Mesh-convergence check for the free-free isotropic TARGET case (LESSONS
!  §23.7 item 2 / §23.6), item 2 of the two open follow-ups the original
!  deck flagged but never ran: "rerun NRAD=NCIRC=64,80 (Omega stable to
!  <0.5% expected)". This is the 80x80 variant. Calibration (Pass 1,
!  PHI=120) is NOT repeated here -- it already passed at NRAD=NCIRC=48
!  (Omega=10.180 vs expected ~10.19, 0.09%) and the BREF convention doesn't
!  depend on mesh density, so re-running it at every mesh density would
!  just burn compute for no new information. Includes the same Uz-dominance
!  tagging as ansys_ff_isoval_tagged.inp so mesh convergence and mode
!  classification are checked together in one pass.
!
!  NOTE (honesty flag): the *GET/*VGET/*VOPER/*VSCFUN tagging sequence was
!  written from documented APDL syntax but NOT executed against a real
!  Mechanical APDL install -- sanity-check the .err log after submitting.
!
!  Run headless (single command, no GUI):
!     mapdl -b -i ansys_ff_isoval_mesh80.inp -o ansys_ff_isoval_mesh80_out.txt
!
!  Outputs: sector_modes_target_mesh80.txt, sector_modes_target_mesh80_tags.txt
! ===========================================================================

FINISH
/CLEAR,NOSTART
/TITLE, Free-free isotropic validation -- TARGET (PHI=90), mesh 80x80

ISO    = 1
BC     = 0
BREF   = 0
R_i    = 4.0
R_o    = 8.0
PHI    = 90.0
H      = 0.08

RHO    = 7800.0
E_iso  = 210.0e9
NU_iso = 0.30

NRAD   = 80
NCIRC  = 80
NMODES = 24
PI     = 3.14159265358979

/PREP7
LOCAL, 11, 1, 0,0,0
CSYS, 11
ET, 1, SHELL281
SECTYPE, 1, SHELL
SECDATA, H, 1
MP, EX,1,E_iso $ MP, EY,1,E_iso $ MP, EZ,1,E_iso
MP, PRXY,1,NU_iso $ MP, PRYZ,1,NU_iso $ MP, PRXZ,1,NU_iso
GG = E_iso/(2*(1+NU_iso))
MP, GXY,1,GG $ MP, GYZ,1,GG $ MP, GXZ,1,GG
MP, DENS,1,RHO
CSYS, 0
PCIRC, R_i, R_o, 0, PHI
ESYS, 11
TYPE,1 $ SECNUM,1 $ MAT,1
CSYS, 11
LSEL, S, LOC, Y, 0  $ LSEL, A, LOC, Y, PHI
LESIZE, ALL, , , NRAD
LSEL, S, LOC, X, R_i $ LSEL, A, LOC, X, R_o
LESIZE, ALL, , , NCIRC
ALLSEL, ALL
MSHKEY, 1 $ AMESH, ALL
ALLSEL, ALL
FINISH

/SOLU
ANTYPE, MODAL
MODOPT, LANB, NMODES, -1.0, , , ON
MXPAND, NMODES, , , YES
SOLVE
FINISH

/POST1
D11 = E_iso*H**3/(12*(1-NU_iso**2))
*IF, BREF, EQ, 1, THEN
  BL = R_o - R_i
*ELSE
  BL = R_o
*ENDIF
KFAC = BL**2*sqrt(RHO*H/D11)

*DIM, FR2, ARRAY, NMODES
*DO, I, 1, NMODES
  *GET, FR2(I), MODE, I, FREQ
*ENDDO

*CFOPEN, sector_modes_target_mesh80, txt
*VWRITE
('mode      f[Hz]              Omega   (TARGET mesh 80x80: BC=0,ISO=1,BREF=0,PHI=90; compare to plate_solver Omega_lit=[12.6596,15.1389,24.3442,33.3391,37.9182,39.5575,54.0755,63.2524] and to the NRAD=NCIRC=48 baseline)')
*DO, I, 1, NMODES
  OM = 2*PI*FR2(I)*KFAC
  *VWRITE, I, FR2(I), OM
(F4.0, 3X, E16.8, 3X, F14.6)
*ENDDO
*CFCLOS

! ---- Uz-dominance tagging (same macro as ansys_ff_isoval_tagged.inp) ----
*GET, NMX, NODE, 0, NUM, MAX
*DIM, UXA, ARRAY, NMX
*DIM, UYA, ARRAY, NMX
*DIM, UZA, ARRAY, NMX
*DIM, UX2, ARRAY, NMX
*DIM, UY2, ARRAY, NMX
*DIM, UZ2, ARRAY, NMX
*DIM, TAG, ARRAY, NMODES

*DO, I, 1, NMODES
  SET, 1, I
  *VGET, UXA(1), NODE, 1, U, X
  *VGET, UYA(1), NODE, 1, U, Y
  *VGET, UZA(1), NODE, 1, U, Z
  *VOPER, UX2(1), UXA(1), MULT, UXA(1)
  *VOPER, UY2(1), UYA(1), MULT, UYA(1)
  *VOPER, UZ2(1), UZA(1), MULT, UZA(1)
  *VSCFUN, SUX2, SUM, UX2(1)
  *VSCFUN, SUY2, SUM, UY2(1)
  *VSCFUN, SUZ2, SUM, UZ2(1)
  TAG(I) = SUZ2 / (SUX2 + SUY2 + SUZ2 + 1.0E-30)
*ENDDO

*CFOPEN, sector_modes_target_mesh80_tags, txt
*VWRITE
('mode      f[Hz]              Omega          UzFrac   (>0.9=bending-dominant, <0.5=in-plane/coupled)')
*DO, I, 1, NMODES
  OM = 2*PI*FR2(I)*KFAC
  *VWRITE, I, FR2(I), OM, TAG(I)
(F4.0, 3X, E16.8, 3X, F14.6, 3X, F8.4)
*ENDDO
*CFCLOS

FINISH
! ---------------------------------------------------------------------------
!  AFTER RUNNING: compare sector_modes_target_mesh80.txt's elastic-mode
!  Omega column against the NRAD=NCIRC=48 baseline
!  ([12.6596,15.1389,24.3442,33.3391,37.9182,39.5575,54.0755,63.2524]-style
!  positions, or better, against the actual baseline run's own numbers).
!  Expected: <0.5% shift if the mesh was already converged. A LARGER shift,
!  especially concentrated on modes 7,10,12,14 (the ones that did NOT match
!  plate_solver at NRAD=NCIRC=48), would indicate those specific mode
!  shapes were mesh-under-resolved rather than reflecting a real solver
!  discrepancy.
! ===========================================================================
